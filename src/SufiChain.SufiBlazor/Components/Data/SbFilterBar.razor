@namespace SufiChain.SufiBlazor.Components.Data
@using SufiChain.SufiBlazor.Components.Forms.Internal
@implements IDisposable
@inject IStringLocalizer<SufiBlazorResource> L

<div class="sb-filter-bar @Class">
    @if (ShowSearch)
    {
        <div class="sb-filter-bar__search">
            <input type="text"
                   class="sb-filter-bar__search-input"
                   value="@_searchSync.DomValue"
                   @oninput="OnSearchInput"
                   placeholder="@(SearchPlaceholder ?? L["Search_Placeholder"])" />
            @if (!string.IsNullOrEmpty(_searchSync.Draft))
            {
                <button type="button" class="sb-filter-bar__search-clear" @onclick="ClearSearch">
                    ×
                </button>
            }
        </div>
    }
    
    <div class="sb-filter-bar__filters">
        @ChildContent
    </div>
    
    @if (ActiveFilters.Any())
    {
        <div class="sb-filter-bar__active">
            @foreach (var filter in ActiveFilters)
            {
                <span class="sb-filter-bar__tag">
                    <span class="sb-filter-bar__tag-label">@filter.Label:</span>
                    <span class="sb-filter-bar__tag-value">@filter.Value</span>
                    <button type="button" 
                            class="sb-filter-bar__tag-remove"
                            @onclick="() => RemoveFilter(filter)">
                        ×
                    </button>
                </span>
            }
            <button type="button" class="sb-filter-bar__clear-all" @onclick="ClearAllFilters">
                @L["ClearAll"]
            </button>
        </div>
    }
    
    @if (Actions != null)
    {
        <div class="sb-filter-bar__actions">
            @Actions
        </div>
    }
</div>

@code {
    private readonly SbTextInputSync _searchSync = new();
    private CancellationTokenSource? _debounceCts;
    private long _searchInputVersion;
    
    /// <summary>
    /// Filter controls content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Whether to show search input.
    /// </summary>
    [Parameter]
    public bool ShowSearch { get; set; } = true;
    
    /// <summary>
    /// Search value.
    /// </summary>
    [Parameter]
    public string? SearchValue { get; set; }
    
    /// <summary>
    /// Callback when search value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> SearchValueChanged { get; set; }
    
    /// <summary>
    /// Search placeholder.
    /// </summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }
    
    /// <summary>
    /// Debounce delay for search.
    /// </summary>
    [Parameter]
    public int SearchDebounceMs { get; set; } = 300;

    /// <summary>
    /// Clock for the search debounce. Unset uses the system clock.
    /// </summary>
    [Parameter]
    public TimeProvider? Clock { get; set; }
    
    /// <summary>
    /// Active filters.
    /// </summary>
    [Parameter]
    public List<SbFilterTag> ActiveFilters { get; set; } = new();
    
    /// <summary>
    /// Callback when active filters change.
    /// </summary>
    [Parameter]
    public EventCallback<List<SbFilterTag>> ActiveFiltersChanged { get; set; }
    
    /// <summary>
    /// Action buttons.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
    
    /// <summary>
    /// Callback when filters are applied.
    /// </summary>
    [Parameter]
    public EventCallback OnApply { get; set; }
    
    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    protected override void OnParametersSet()
    {
        _searchSync.ObserveParent(SearchValue);
    }

    private void OnSearchInput(ChangeEventArgs args)
    {
        if (!_searchSync.WriteInput(args.Value?.ToString()))
        {
            return;
        }

        var inputVersion = ++_searchInputVersion;
        ScheduleDebounce(inputVersion);
    }

    private void ScheduleDebounce(long inputVersion)
    {
        CancelDebounce();
        var cts = new CancellationTokenSource();
        _debounceCts = cts;
        _ = CompleteDebounceAsync(inputVersion, cts.Token);
    }

    private async Task CompleteDebounceAsync(long inputVersion, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(SearchDebounceMs), ActiveClock, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                if (cancellationToken.IsCancellationRequested || inputVersion != _searchInputVersion)
                {
                    return;
                }

                await SearchValueChanged.InvokeAsync(_searchSync.Draft);
                await OnApply.InvokeAsync();
            });
        }
        catch (ObjectDisposedException)
        {
            // The component was removed before the debounce elapsed.
        }
    }

    private TimeProvider ActiveClock => Clock ?? TimeProvider.System;

    private void CancelDebounce()
    {
        if (_debounceCts is null)
        {
            return;
        }

        _debounceCts.Cancel();
        _debounceCts.Dispose();
        _debounceCts = null;
    }

    public void Dispose()
    {
        _searchInputVersion++;
        CancelDebounce();
    }
    
    private async Task ClearSearch()
    {
        _searchInputVersion++;
        CancelDebounce();
        _searchSync.WriteInput(null);
        await SearchValueChanged.InvokeAsync(null);
        await OnApply.InvokeAsync();
    }
    
    private async Task RemoveFilter(SbFilterTag filter)
    {
        ActiveFilters.Remove(filter);
        await ActiveFiltersChanged.InvokeAsync(ActiveFilters);
        await OnApply.InvokeAsync();
    }
    
    private async Task ClearAllFilters()
    {
        _searchInputVersion++;
        CancelDebounce();
        ActiveFilters.Clear();
        _searchSync.WriteInput(null);
        await ActiveFiltersChanged.InvokeAsync(ActiveFilters);
        await SearchValueChanged.InvokeAsync(null);
        await OnApply.InvokeAsync();
    }
    
    /// <summary>
    /// Add a filter tag.
    /// </summary>
    public async Task AddFilterAsync(string label, string value, string? key = null)
    {
        var filter = new SbFilterTag { Label = label, Value = value, Key = key ?? label };
        
        // Replace existing filter with same key
        ActiveFilters.RemoveAll(f => f.Key == filter.Key);
        ActiveFilters.Add(filter);
        
        await ActiveFiltersChanged.InvokeAsync(ActiveFilters);
    }
}

/// <summary>
/// Represents an active filter tag.
/// </summary>
public class SbFilterTag
{
    /// <summary>
    /// Filter key.
    /// </summary>
    public string Key { get; set; } = "";
    
    /// <summary>
    /// Filter label.
    /// </summary>
    public string Label { get; set; } = "";
    
    /// <summary>
    /// Filter value display.
    /// </summary>
    public string Value { get; set; } = "";
}
