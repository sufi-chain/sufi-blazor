@namespace SufiChain.SufiBlazor.Components.Data
@typeparam TItem
@using SufiChain.SufiBlazor.Components.Actions
@using SufiChain.SufiBlazor.Components.Forms
@using SufiChain.SufiBlazor.Contracts.Data
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SufiBlazorResource> L
@inject IStringLocalizer<SufiBlazorResource> L

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@* When in edit mode, provide EditContext so InputBase-derived editors (SbTextField, SbCheckbox) don't throw *@
<CascadingValue Value="_gridEditContext" IsFixed="false">
<div class="sb-datagrid @Class @GetGridCssClasses()"
     dir="@(EffectiveRightToLeft ? "rtl" : "ltr")"
     @ref="_gridRef"
     @onkeydown="HandleKeyDown"
     tabindex="0"
     role="application"
     aria-label="@AriaLabel">
    @if (Loading)
    {
        <div class="sb-datagrid__loading" role="status" aria-live="polite">
            <div class="sb-datagrid__loading-spinner" aria-hidden="true"></div>
            <span>Loading...</span>
        </div>
    }
    
    @* Screen reader announcements *@
    <div class="sb-datagrid__sr-only" role="status" aria-live="polite" aria-atomic="true">
        @_screenReaderAnnouncement
    </div>
    
    @* Active Filters Bar *@
    @if (ShowFilterBar && _activeFilters.Any())
    {
        <div class="sb-datagrid__filter-bar" role="region" aria-label="Active filters">
            <span class="sb-datagrid__filter-bar-label">Filters:</span>
            @foreach (var filter in _activeFilters.Values)
            {
                var column = _columns.FirstOrDefault(c => c.Field == filter.Field);
                <span class="sb-datagrid__filter-tag">
                    <span class="sb-datagrid__filter-tag-text">
                        @(column?.Title ?? filter.Field): @GetFilterDisplayValue(filter)
                    </span>
                    <SbIconButton Size="SbSize.Sm"
                                 Variant="SbButtonVariant.Ghost"
                                 Color="SbColor.Secondary"
                                 Class="sb-datagrid__filter-tag-remove"
                                 AriaLabel="@($"Remove filter for {column?.Title ?? filter.Field}")"
                                 OnClick="@(() => RemoveFilterAsync(filter.Field))">
                        <Icon><SbIcon Name="x" Size="SbSize.Sm" /></Icon>
                    </SbIconButton>
                </span>
            }
            <SbButton Size="SbSize.Sm"
                     Variant="SbButtonVariant.Outline"
                     Color="SbColor.Secondary"
                     Class="sb-datagrid__filter-bar-clear"
                     OnClick="ClearAllFiltersAsync">
                Clear all
            </SbButton>
        </div>
    }
    
    <div class="sb-datagrid__container" style="@GetContainerStyle()">
        <table class="sb-datagrid__table" 
               style="@GetTableStyle()"
               role="grid"
               aria-rowcount="@TotalCount"
               aria-colcount="@GetTotalColumnCount()"
               aria-multiselectable="@(SelectionMode == SbSelectionMode.MultipleRows ? "true" : "false")"
               aria-busy="@Loading.ToString().ToLower()">
            <thead class="sb-datagrid__header" role="rowgroup">
                <tr role="row" aria-rowindex="1">
                    @{
                        var colIndex = 1;
                    }
                    @if (DetailTemplate != null)
                    {
                        <th class="sb-datagrid__cell sb-datagrid__cell--expand"
                            role="columnheader"
                            aria-colindex="@colIndex"
                            scope="col"
                            style="width: 52px; min-width: 52px;">
                            <span class="sb-sr-only">Expand/Collapse</span>
                        </th>
                        colIndex++;
                    }
                    @if (SelectionMode != SbSelectionMode.None)
                    {
                        <th class="sb-datagrid__cell sb-datagrid__cell--selection"
                            role="columnheader"
                            aria-colindex="@colIndex"
                            scope="col">
                            @if (SelectionMode == SbSelectionMode.MultipleRows)
                            {
                                <SbCheckbox Value="@IsAllSelected"
                                            ValueChanged="ToggleSelectAll"
                                            AriaLabel="Select all rows" />
                            }
                        </th>
                        colIndex++;
                    }
                    @foreach (var column in _columns.Where(c => c.Visible))
                    {
                        var columnIndex = colIndex;
                        <th class="sb-datagrid__cell sb-datagrid__cell--header @column.Class @(column.Sortable ? "sb-datagrid__cell--sortable" : "") @(column.Filterable && ShowColumnFilters ? "sb-datagrid__cell--filterable" : "") @GetFrozenColumnClass(column)"
                            style="@GetColumnHeaderStyle(column, columnIndex)"
                            role="columnheader"
                            scope="col"
                            aria-colindex="@colIndex"
                            aria-sort="@GetAriaSortValue(column)"
                            tabindex="@(column.Sortable ? 0 : -1)"
                            @onclick="() => OnHeaderClick(column)"
                            @onkeydown="e => OnHeaderKeyDown(e, column)">
                            <div class="sb-datagrid__header-content">
                                @if (column.HeaderTemplate != null)
                                {
                                    @column.HeaderTemplate
                                }
                                else
                                {
                                    <span class="sb-datagrid__header-title">@column.Title</span>
                                }
                                
                                @if (column.Sortable && !string.IsNullOrEmpty(column.Field))
                                {
                                    <span class="sb-datagrid__sort-icon @GetSortIconClass(column)" aria-hidden="true">
                                        <SbIcon Name="@GetSortIconName(column)" Size="SbSize.Sm" />
                                    </span>
                                }
                                
                                @if (column.Filterable && ShowColumnFilters && !string.IsNullOrEmpty(column.Field))
                                {
                                    <SbColumnFilterMenu Field="@column.Field"
                                                        ColumnTitle="@column.Title"
                                                        FieldType="@column.GetFieldType()"
                                                        CurrentFilter="@GetColumnFilter(column.Field)"
                                                        FilterTemplate="@column.FilterTemplate"
                                                        OnFilterChanged="filter => OnColumnFilterChanged(column.Field!, filter)" />
                                }
                            </div>
                            @if (column.Resizable && AllowColumnResize)
                            {
                                <div class="sb-datagrid__resize-handle"
                                     @onmousedown="(e) => _ = StartColumnResize(e, column)"
                                     @onmousedown:stopPropagation="true"
                                     @onmousedown:preventDefault="true"
                                     @onclick:stopPropagation="true"
                                     aria-hidden="true"
                                     title="Drag to resize column"></div>
                            }
                        </th>
                        colIndex++;
                    }
                    @if (EditMode != SbEditMode.None && ShowEditActions)
                    {
                        <th class="sb-datagrid__cell sb-datagrid__cell--header sb-datagrid__cell--actions"
                            role="columnheader"
                            scope="col"
                            aria-colindex="@colIndex">
                            <span class="sb-datagrid__header-title">Actions</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody class="sb-datagrid__body" role="rowgroup">
                @if (VirtualizationEnabled && _virtualizedItems.Any())
                {
                    <Virtualize Items="@_virtualizedItems" Context="pair" ItemSize="@GetEffectiveRowHeight()" OverscanCount="@OverscanCount" SpacerElement="tr">
                        @RenderRow(pair.item, pair.index)
                    </Virtualize>
                }
                else if (_displayItems.Any())
                {
                    var rowIndex = 0;
                    foreach (var item in _displayItems)
                    {
                        @RenderRow(item, rowIndex)
                        rowIndex++;
                    }
                }
                else
                {
                    <tr class="sb-datagrid__row sb-datagrid__row--empty">
                        <td class="sb-datagrid__cell sb-datagrid__cell--empty" 
                            colspan="@GetTotalColumnCount()">
                            @if (EmptyTemplate != null)
                            {
                                @EmptyTemplate
                            }
                            else
                            {
                                <span>@(EmptyText ?? "No data available")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            @if (_columns.Any(c => c.FooterTemplate != null))
            {
                <tfoot class="sb-datagrid__footer">
                    <tr>
                        @if (DetailTemplate != null)
                        {
                            <td class="sb-datagrid__cell"></td>
                        }
                        @if (SelectionMode != SbSelectionMode.None)
                        {
                            <td class="sb-datagrid__cell"></td>
                        }
                        @foreach (var column in _columns.Where(c => c.Visible))
                        {
                            <td class="sb-datagrid__cell sb-datagrid__cell--footer @column.Class"
                                style="@GetColumnStyle(column)">
                                @column.FooterTemplate
                            </td>
                        }
                        @if (EditMode != SbEditMode.None && ShowEditActions)
                        {
                            <td class="sb-datagrid__cell sb-datagrid__cell--footer"></td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    
    @if (ShowPagination && TotalCount > 0 && !VirtualizationEnabled)
    {
        <div class="sb-datagrid__pagination">
            <SbPagination PageIndex="@_pageIndex"
                          PageIndexChanged="@OnPageIndexChanged"
                          PageSize="@_pageSize"
                          PageSizeChanged="@OnPageSizeChanged"
                          TotalCount="@TotalCount"
                          ShowPageSizeSelector="@ShowPageSizeSelector"
                          PageSizeOptions="@PageSizeOptions" />
        </div>
    }
</div>
</CascadingValue>

@{
    RenderFragment RenderRow(TItem item, int rowIndex) => @<text>
        @{
            var key = GetItemKey(item);
            var isSelected = _selectedKeys.Contains(key);
            var isRowEditing = IsEditingRow(key);
            var editItem = isRowEditing && _editingItem != null ? _editingItem : item;
            var isFocused = _focusedRowIndex == rowIndex;
            var ariaRowIndex = rowIndex + 2; // +2 because header is row 1
            var cellColIndex = 1;
        }
        @{
            var isExpanded = _expandedRows.Contains(key);
        }
        <tr class="sb-datagrid__row @(isSelected ? "sb-datagrid__row--selected" : "") @(isRowEditing ? "sb-datagrid__row--editing" : "") @(isFocused ? "sb-datagrid__row--focused" : "") @(Striped && rowIndex % 2 == 1 ? "sb-datagrid__row--striped" : "")"
            style="@GetRowStyle()"
            role="row"
            aria-rowindex="@ariaRowIndex"
            aria-selected="@isSelected.ToString().ToLower()"
            aria-expanded="@(DetailTemplate != null ? isExpanded.ToString().ToLower() : null)"
            tabindex="@(isFocused ? 0 : -1)"
            data-row-key="@key"
            @onclick="() => OnRowClick(item, key)"
            @ondblclick="() => OnRowDoubleClick(item, rowIndex)"
            @onfocus="() => OnRowFocus(rowIndex)">
            @if (DetailTemplate != null)
            {
                <td class="sb-datagrid__cell sb-datagrid__cell--expand"
                    role="gridcell"
                    aria-colindex="@cellColIndex">
                    <button type="button" 
                            class="sb-datagrid__expand-btn @(isExpanded ? "sb-datagrid__expand-btn--expanded" : "")"
                            @onclick="() => ToggleRowExpand(key)"
                            @onclick:stopPropagation="true"
                            aria-label="@(isExpanded ? "Collapse row details" : "Expand row details")">
                        <SbIcon Name="@(isExpanded ? "chevron-down" : (EffectiveRightToLeft ? "chevron-left" : "chevron-right"))" Size="SbSize.Sm" />
                    </button>
                </td>
                cellColIndex++;
            }
            @if (SelectionMode != SbSelectionMode.None)
            {
                <td class="sb-datagrid__cell sb-datagrid__cell--selection"
                    role="gridcell"
                    aria-colindex="@cellColIndex">
                    <SbCheckbox Value="@isSelected"
                                            ValueChanged="() => ToggleSelection(key, item)"
                                            AriaLabel="@($"Select row {rowIndex + 1}")" />
                </td>
                cellColIndex++;
            }
            @foreach (var column in _columns.Where(c => c.Visible))
            {
                var col = column;
                var isCellEditing = isRowEditing && col.Editable && (EditMode == SbEditMode.Row || (EditMode == SbEditMode.Cell && (_editingColumnField == null || _editingColumnField == col.Field)));
                var cellContext = new SbCellContext<TItem>(editItem, rowIndex, col);
                var isCellFocused = _focusedRowIndex == rowIndex && _focusedColIndex == cellColIndex;
                var currentCellColIndex = cellColIndex;
                
                <td class="sb-datagrid__cell @col.Class @(isCellEditing ? "sb-datagrid__cell--editing" : "") @(isCellFocused ? "sb-datagrid__cell--focused" : "") @GetFrozenColumnClass(col)" 
                    style="@GetColumnCellStyle(col, currentCellColIndex)"
                    role="gridcell"
                    aria-colindex="@cellColIndex"
                    tabindex="@(isCellFocused ? 0 : -1)"
                    @onclick:stopPropagation="@(EditMode == SbEditMode.Cell && col.Editable)"
                    @onclick="() => OnCellClick(item, rowIndex, col)">
                    @if (isCellEditing && col.Editable)
                    {
                        @if (col.EditTemplate != null)
                        {
                            @col.EditTemplate(cellContext)
                        }
                        else
                        {
                            @RenderDefaultEditor(col, editItem)
                        }
                    }
                    else if (col.CellTemplate != null)
                    {
                        @col.CellTemplate(cellContext)
                    }
                    else
                    {
                        @col.GetDisplayValue(item)
                    }
                </td>
                cellColIndex++;
            }
            @if (EditMode != SbEditMode.None && ShowEditActions)
            {
                <td class="sb-datagrid__cell sb-datagrid__cell--actions"
                    role="gridcell"
                    aria-colindex="@cellColIndex">
                    @if (isRowEditing)
                    {
                        <SbIconButton Color="SbColor.Success"
                                      OnClick="SaveEditAsync"
                                      Title="@L["Save"]"
                                      AriaLabel="@L["SaveChanges"]"
                                      Class="sb-datagrid__action-btn">
                            <Icon><SbIcon Name="check" /></Icon>
                        </SbIconButton>
                        <SbIconButton Color="SbColor.Danger"
                                      OnClick="CancelEditAsync"
                                      Title="@L["Cancel"]"
                                      AriaLabel="@L["CancelEditing"]"
                                      Class="sb-datagrid__action-btn">
                            <Icon><SbIcon Name="x" /></Icon>
                        </SbIconButton>
                    }
                    else
                    {
                        <SbIconButton Color="SbColor.Primary"
                                      OnClick="() => StartEditAsync(item, rowIndex)"
                                      Title="@L["EditRow"]"
                                      AriaLabel="@L["EditRow"]"
                                      Class="sb-datagrid__action-btn">
                            <Icon><SbIcon Name="edit" /></Icon>
                        </SbIconButton>
                    }
                </td>
            }
        </tr>
        @if (DetailTemplate != null && isExpanded)
        {
            <tr class="sb-datagrid__row sb-datagrid__row--detail" role="row">
                <td class="sb-datagrid__cell sb-datagrid__cell--detail" 
                    colspan="@GetTotalColumnCount()"
                    role="gridcell">
                    <div class="sb-datagrid__detail-content">
                        @DetailTemplate(item)
                    </div>
                </td>
            </tr>
        }
    </text>;
    
    RenderFragment RenderDefaultEditor(SbColumn<TItem> column, TItem item) => @<text>
        @{
            var fieldType = column.GetFieldType();
            var currentValue = column.GetValue(item);
            var col = column;
        }
        @* Use native inputs to avoid InputBase's ValueExpression/EditContext requirements *@
        @if (fieldType == typeof(bool) || fieldType == typeof(bool?))
        {
            <input type="checkbox"
                   class="sb-datagrid__editor sb-datagrid__editor--checkbox"
                   checked="@((bool?)currentValue ?? false)"
                   @onchange="e => OnCellValueChangedFromInput(col, e)" />
        }
        else if (fieldType == typeof(int) || fieldType == typeof(int?) ||
                 fieldType == typeof(long) || fieldType == typeof(long?) ||
                 fieldType == typeof(decimal) || fieldType == typeof(decimal?) ||
                 fieldType == typeof(double) || fieldType == typeof(double?) ||
                 fieldType == typeof(float) || fieldType == typeof(float?))
        {
            <input type="number"
                   class="sb-datagrid__editor sb-datagrid__editor--number"
                   value="@FormatNumberForInput(currentValue)"
                   @onchange="e => OnCellValueChangedFromInput(col, e)" />
        }
        else if (fieldType == typeof(DateTime) || fieldType == typeof(DateTime?) ||
                 fieldType == typeof(DateOnly) || fieldType == typeof(DateOnly?))
        {
            <input type="date"
                   class="sb-datagrid__editor sb-datagrid__editor--date"
                   value="@FormatDateForInput(currentValue)"
                   @onchange="e => OnCellValueChangedFromInput(col, e)" />
        }
        else
        {
            <input type="text"
                   class="sb-datagrid__editor sb-datagrid__editor--text"
                   value="@(currentValue?.ToString())"
                   @onchange="e => OnCellValueChangedFromInput(col, e)" />
        }
    </text>;
}

@code {
#nullable enable
    private List<SbColumn<TItem>> _columns = new();
    private List<TItem> _displayItems = new();
    private List<(TItem item, int index)> _virtualizedItems = new();
    private HashSet<string> _selectedKeys = new();
    private SbSort? _currentSort;
    
    // Editing state
    private string? _editingRowKey;
    private string? _editingColumnField;
    private SbRowEditContext<TItem>? _currentEditContext;
    private TItem? _editingItem;
    private EditContext? _gridEditContext;
    
    // Accessibility state
    private ElementReference _gridRef;
    private int _focusedRowIndex = 0;
    private int _focusedColIndex = 1;
    private string? _screenReaderAnnouncement;
    
    // Filtering state
    private Dictionary<string, SbFilter> _activeFilters = new();
    
    // Row details state
    private HashSet<string> _expandedRows = new();
    
    // Column resize state
    private Dictionary<string, ElementReference> _headerRefs = new();
    private Dictionary<string, int> _columnWidths = new();
    private string? _resizingColumn;
    private DotNetObjectReference<SbDataGrid<TItem>>? _dotNetRef;
    
    /// <summary>
    /// Column definitions (child content).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Items to display (client mode).
    /// </summary>
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }
    
    /// <summary>
    /// Data provider for server mode.
    /// </summary>
    [Parameter]
    public Func<SbDataRequest, Task<SbDataResponse<TItem>>>? ItemsProvider { get; set; }
    
    /// <summary>
    /// The current page index (zero-based).
    /// </summary>
    [Parameter]
    public int PageIndex { get; set; }
    
    /// <summary>
    /// Callback when page index changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> PageIndexChanged { get; set; }
    
    
    /// <summary>
    /// The number of items per page.
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 10;
    
    /// <summary>
    /// Callback when page size changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }
    
    /// <summary>
    /// Total count of items (set by server mode or calculated in client mode).
    /// </summary>
    [Parameter]
    public long TotalCount { get; set; }
    
    /// <summary>
    /// Whether data is currently loading.
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }
    
    /// <summary>
    /// The selection mode.
    /// </summary>
    [Parameter]
    public SbSelectionMode SelectionMode { get; set; } = SbSelectionMode.None;
    
    /// <summary>
    /// Selected row keys.
    /// </summary>
    [Parameter]
    public IReadOnlySet<string>? SelectedKeys { get; set; }
    
    /// <summary>
    /// Callback when selected keys change.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlySet<string>> SelectedKeysChanged { get; set; }
    
    /// <summary>
    /// Callback when selected items change.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<TItem>> SelectedItemsChanged { get; set; }
    
    /// <summary>
    /// Function to get the unique key for an item.
    /// </summary>
    [Parameter]
    public Func<TItem, string>? KeySelector { get; set; }
    
    /// <summary>
    /// Whether to show the pagination controls.
    /// </summary>
    [Parameter]
    public bool ShowPagination { get; set; } = true;
    
    /// <summary>
    /// Whether to show the page size selector.
    /// </summary>
    [Parameter]
    public bool ShowPageSizeSelector { get; set; } = true;
    
    /// <summary>
    /// Available page size options.
    /// </summary>
    [Parameter]
    public int[] PageSizeOptions { get; set; } = { 5, 10, 25, 50, 100 };
    
    /// <summary>
    /// Template to display when there are no items.
    /// </summary>
    [Parameter]
    public RenderFragment? EmptyTemplate { get; set; }

    /// <summary>
    /// Plain-text fallback when <see cref="EmptyTemplate"/> is not set.
    /// </summary>
    [Parameter]
    public string? EmptyText { get; set; }
    
    /// <summary>
    /// Callback when a row is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<TItem> OnRowClicked { get; set; }
    
    /// <summary>
    /// Callback when sort changes.
    /// </summary>
    [Parameter]
    public EventCallback<SbSort?> OnSortChanged { get; set; }
    
    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }
    
    // ============ RTL and Visual Parameters ============
    
    /// <summary>
    /// Whether to render the grid in right-to-left mode. When null, follows the current UI culture (e.g. RTL for Farsi/Arabic).
    /// </summary>
    [Parameter]
    public bool? RightToLeft { get; set; }
    
    private bool EffectiveRightToLeft => RightToLeft ?? CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;
    
    /// <summary>
    /// The row density (spacing) of the grid.
    /// </summary>
    [Parameter]
    public SbDataGridDensity Density { get; set; } = SbDataGridDensity.Default;
    
    /// <summary>
    /// Whether to show alternating row colors (striped rows).
    /// </summary>
    [Parameter]
    public bool Striped { get; set; }
    
    /// <summary>
    /// Whether to show row hover effect.
    /// </summary>
    [Parameter]
    public bool Hoverable { get; set; } = true;
    
    /// <summary>
    /// Whether to show grid borders.
    /// </summary>
    [Parameter]
    public bool Bordered { get; set; } = true;
    
    /// <summary>
    /// Whether to show column filter menus.
    /// </summary>
    [Parameter]
    public bool ShowColumnFilters { get; set; } = true;
    
    // ============ Column Resize Parameters ============
    
    /// <summary>
    /// Whether to allow column resizing.
    /// </summary>
    [Parameter]
    public bool AllowColumnResize { get; set; }
    
    /// <summary>
    /// Callback when a column is resized.
    /// </summary>
    [Parameter]
    public EventCallback<(string Field, int Width)> OnColumnResized { get; set; }
    
    // ============ Row Details Parameters ============
    
    /// <summary>
    /// Template for expandable row details (master-detail).
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? DetailTemplate { get; set; }
    
    /// <summary>
    /// Keys of rows that should be expanded by default.
    /// </summary>
    [Parameter]
    public IEnumerable<string>? ExpandedRowKeys { get; set; }
    
    /// <summary>
    /// Callback when a row is expanded or collapsed.
    /// </summary>
    [Parameter]
    public EventCallback<(string Key, bool IsExpanded)> OnRowExpandChanged { get; set; }
    
    // ============ Filter Bar Parameters ============
    
    /// <summary>
    /// Whether to show the active filters bar above the grid.
    /// </summary>
    [Parameter]
    public bool ShowFilterBar { get; set; } = true;
    
    // ============ Virtualization Parameters ============
    
    /// <summary>
    /// Whether to enable row virtualization for large datasets.
    /// When enabled, only visible rows are rendered for better performance.
    /// </summary>
    [Parameter]
    public bool VirtualizationEnabled { get; set; }
    
    /// <summary>
    /// The height of each row in pixels. Required for virtualization calculations.
    /// Default is 48px.
    /// </summary>
    [Parameter]
    public float RowHeight { get; set; } = 48f;
    
    /// <summary>
    /// The number of additional rows to render outside the visible area.
    /// Higher values reduce flickering but use more memory. Default is 3.
    /// </summary>
    [Parameter]
    public int OverscanCount { get; set; } = 3;
    
    /// <summary>
    /// The height of the virtualized container. Required when VirtualizationEnabled is true.
    /// Can be a CSS value like "400px", "50vh", or "100%".
    /// </summary>
    [Parameter]
    public string? Height { get; set; }
    
    // ============ Editing Parameters ============
    
    /// <summary>
    /// The edit mode for the grid.
    /// </summary>
    [Parameter]
    public SbEditMode EditMode { get; set; } = SbEditMode.None;
    
    /// <summary>
    /// Callback when a row starts being edited.
    /// Set Cancel to true to prevent editing.
    /// </summary>
    [Parameter]
    public EventCallback<SbRowEditEventArgs<TItem>> OnRowEditing { get; set; }
    
    /// <summary>
    /// Callback when a row edit is completed (saved).
    /// </summary>
    [Parameter]
    public EventCallback<SbRowEditCompletedEventArgs<TItem>> OnRowEdited { get; set; }
    
    /// <summary>
    /// Callback when a row edit is cancelled.
    /// </summary>
    [Parameter]
