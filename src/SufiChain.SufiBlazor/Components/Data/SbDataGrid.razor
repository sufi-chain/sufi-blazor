    private string GetPageInfo()
    {
        if (TotalCount == 0) return "No items";
        var pageSize = _pageSize > 0 ? _pageSize : PageSize;
        var start = _pageIndex * pageSize + 1;
        var end = Math.Min((_pageIndex + 1) * pageSize, TotalCount);
        return $"{start}-{end} of {TotalCount}";
    }
    
    private string GetGridCssClasses()
    {
        var classes = new List<string>();
        classes.Add($"sb-datagrid--density-{Density.ToString().ToLowerInvariant()}");
        if (Striped) classes.Add("sb-datagrid--striped");
        if (Hoverable) classes.Add("sb-datagrid--hoverable");
        if (Bordered) classes.Add("sb-datagrid--bordered");
        else classes.Add("sb-datagrid--borderless");
        if (VirtualizationEnabled) classes.Add("sb-datagrid--virtualized");
        if (_columns.Any(c => c.Visible && c.Freeze != SbColumnFreeze.None)) classes.Add("sb-datagrid--frozen");
        if (AllowColumnResize) classes.Add("sb-datagrid--resizable");
        return string.Join(" ", classes);
    }
    
