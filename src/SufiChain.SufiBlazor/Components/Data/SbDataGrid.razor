    private string? GetAriaSortValue(SbColumn<TItem> column)
    {
        if (!column.Sortable || string.IsNullOrEmpty(column.Field))
            return null;
        
        if (_currentSort == null || _currentSort.Field != column.Field)
            return "none";
        
        return _currentSort.Direction == SbSortDirection.Ascending ? "ascending" : "descending";
    }
    
    private void OnRowFocus(int rowIndex)
    {
        _focusedRowIndex = rowIndex;
    }
    
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!EnableKeyboardNavigation) return;
        
        var handled = false;
        
        switch (e.Key)
        {
            case "ArrowUp":
                await NavigateRow(-1);
                handled = true;
                break;
            case "ArrowDown":
                await NavigateRow(1);
                handled = true;
                break;
            case "ArrowLeft":
                await NavigateColumn(EffectiveRightToLeft ? 1 : -1);
                handled = true;
                break;
            case "ArrowRight":
                await NavigateColumn(EffectiveRightToLeft ? -1 : 1);
                handled = true;
                break;
            case "Home":
                _focusedRowIndex = 0;
                handled = true;
                break;
            case "End":
                _focusedRowIndex = _displayItems.Count - 1;
                handled = true;
                break;
            case "Enter":
                await HandleEnterKey();
                handled = true;
                break;
            case " ":
                await HandleSpaceKey();
                handled = true;
                break;
            case "Escape":
                if (IsEditing) await CancelEditAsync();
                handled = true;
                break;
        }
        
        if (handled)
        {
            StateHasChanged();
        }
    }
    
    private Task NavigateRow(int delta)
    {
        var newIndex = _focusedRowIndex + delta;
        _focusedRowIndex = Math.Max(0, Math.Min(newIndex, _displayItems.Count - 1));
        
        // Announce current row
        if (_focusedRowIndex >= 0 && _focusedRowIndex < _displayItems.Count)
        {
            AnnounceToScreenReader($"Row {_focusedRowIndex + 1} of {_displayItems.Count}");
        }
        
        return Task.CompletedTask;
    }
    
    private Task NavigateColumn(int delta)
    {
        var maxCol = GetTotalColumnCount();
        var newIndex = _focusedColIndex + delta;
        _focusedColIndex = Math.Max(1, Math.Min(newIndex, maxCol));
        
        // Announce the column
        var visibleColumns = _columns.Where(c => c.Visible).ToList();
        var colOffset = SelectionMode != SbSelectionMode.None ? 1 : 0;
        var colIdx = _focusedColIndex - 1 - colOffset;
        
        if (colIdx >= 0 && colIdx < visibleColumns.Count)
        {
            AnnounceToScreenReader($"Column: {visibleColumns[colIdx].Title}");
        }
        
        return Task.CompletedTask;
    }
    
    private async Task HandleEnterKey()
    {
        if (_focusedRowIndex >= 0 && _focusedRowIndex < _displayItems.Count)
        {
            var item = _displayItems[_focusedRowIndex];
            
            if (IsEditing)
            {
                await SaveEditAsync();
            }
            else if (EditMode != SbEditMode.None)
            {
                await StartEditAsync(item, _focusedRowIndex);
            }
            else if (SelectionMode != SbSelectionMode.None)
            {
                var key = GetItemKey(item);
                await ToggleSelection(key, item);
            }
        }
    }
    
    private async Task HandleSpaceKey()
    {
        if (SelectionMode != SbSelectionMode.None && 
            _focusedRowIndex >= 0 && _focusedRowIndex < _displayItems.Count)
        {
            var item = _displayItems[_focusedRowIndex];
            var key = GetItemKey(item);
            await ToggleSelection(key, item);
            
            var isSelected = _selectedKeys.Contains(key);
            AnnounceToScreenReader(isSelected ? "Row selected" : "Row deselected");
        }
    }
    
    private void AnnounceToScreenReader(string message)
    {
        _screenReaderAnnouncement = message;
        StateHasChanged();
        
        // Clear after a short delay to allow re-announcement of same message
        _ = Task.Delay(100).ContinueWith(_ =>
        {
            _screenReaderAnnouncement = null;
            InvokeAsync(StateHasChanged);
        });
    }
    
    /// <summary>
    /// Focuses a specific row by index.
    /// </summary>
    public async Task FocusRowAsync(int rowIndex)
    {
        _focusedRowIndex = Math.Max(0, Math.Min(rowIndex, _displayItems.Count - 1));
        StateHasChanged();
        
        // Focus the grid element
        await JSRuntime.InvokeVoidAsync("eval", $"document.querySelector('[data-row-key]')?.closest('.sb-datagrid')?.focus()");
    }
    
    // ============ Filtering Methods ============
    
    private SbFilter? GetColumnFilter(string? field)
    {
        if (string.IsNullOrEmpty(field)) return null;
        return _activeFilters.TryGetValue(field, out var filter) ? filter : null;
    }
    
    private async Task OnColumnFilterChanged(string field, SbFilter? filter)
    {
        if (filter == null)
        {
            _activeFilters.Remove(field);
        }
        else
        {
            _activeFilters[field] = filter;
        }
        
        // Reset to first page when filter changes
        SetLocalPageIndex(0);
        await PageIndexChanged.InvokeAsync(0);
        
        await OnFiltersChanged.InvokeAsync(ActiveFilters);
        await RefreshDataAsync();
        
        AnnounceToScreenReader($"Filter applied. Showing {_displayItems.Count} results.");
    }
    
    /// <summary>
    /// Clears all active filters.
    /// </summary>
    public async Task ClearAllFiltersAsync()
    {
        _activeFilters.Clear();
        SetLocalPageIndex(0);
        await PageIndexChanged.InvokeAsync(0);
        await OnFiltersChanged.InvokeAsync(ActiveFilters);
        await RefreshDataAsync();
        StateHasChanged();
        AnnounceToScreenReader("All filters cleared.");
    }
    
    /// <summary>
    /// Sets a filter programmatically (adds or replaces the filter for the given field).
    /// </summary>
    public async Task SetFilterAsync(string field, SbFilterOperator op, object? value, object? value2 = null)
    {
        var filter = new SbFilter(field, op, value, value2);
        _activeFilters[field] = filter;
        await OnFiltersChanged.InvokeAsync(ActiveFilters);
        await RefreshDataAsync();
        StateHasChanged();
    }
    
    /// <summary>
    /// Clears all filters and sets a single filter in one operation. Use when only one filter should be active (e.g. preset "Engineering Only").
    /// Avoids an extra round-trip compared to calling ClearAllFiltersAsync then SetFilterAsync.
    /// </summary>
    public async Task SetOnlyFilterAsync(string field, SbFilterOperator op, object? value, object? value2 = null)
    {
        _activeFilters.Clear();
        SetLocalPageIndex(0);
        var filter = new SbFilter(field, op, value, value2);
        _activeFilters[field] = filter;
        await PageIndexChanged.InvokeAsync(0);
        await OnFiltersChanged.InvokeAsync(ActiveFilters);
        await RefreshDataAsync();
        StateHasChanged();
    }
    
    /// <summary>
    /// Removes a filter by field name.
    /// </summary>
    public async Task RemoveFilterAsync(string field)
    {
        if (_activeFilters.Remove(field))
        {
            await OnFiltersChanged.InvokeAsync(ActiveFilters);
            await RefreshDataAsync();
            StateHasChanged();
        }
    }
    
    private static bool MatchesFilter(object? value, SbColumn<TItem> column, SbFilter filter)
    {
        return filter.Operator switch
        {
            SbFilterOperator.IsNull => value == null,
            SbFilterOperator.IsNotNull => value != null,
            SbFilterOperator.Equals => Equals(value, filter.Value),
            SbFilterOperator.NotEquals => !Equals(value, filter.Value),
            SbFilterOperator.Contains => ContainsString(value, filter.Value),
            SbFilterOperator.StartsWith => StartsWithString(value, filter.Value),
            SbFilterOperator.EndsWith => EndsWithString(value, filter.Value),
            SbFilterOperator.GreaterThan => CompareValues(value, filter.Value) > 0,
            SbFilterOperator.GreaterThanOrEqual => CompareValues(value, filter.Value) >= 0,
            SbFilterOperator.LessThan => CompareValues(value, filter.Value) < 0,
            SbFilterOperator.LessThanOrEqual => CompareValues(value, filter.Value) <= 0,
            _ => true
        };
    }
    
