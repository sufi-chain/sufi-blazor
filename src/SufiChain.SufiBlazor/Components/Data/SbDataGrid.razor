    private bool IsAllSelected => _displayItems.Any() && 
                                   _displayItems.All(item => _selectedKeys.Contains(GetItemKey(item)));
    
    private bool IsServerMode => ItemsProvider != null;
    
    private bool IsEditing => _editingRowKey != null;
    
    private bool IsEditingRow(string key) => _editingRowKey == key;
    
    private bool IsEditingCell(string key, string? field) => 
        _editingRowKey == key && _editingColumnField == field;
    
    private string GetContainerStyle()
    {
        if (!VirtualizationEnabled || string.IsNullOrEmpty(Height))
            return "";
        
        return $"height: {Height}; overflow-y: auto;";
    }
    
    private string GetTableStyle()
    {
        if (VirtualizationEnabled || AllowColumnResize || _columns.Any(c => c.Visible && c.Freeze != SbColumnFreeze.None))
            return "table-layout: fixed;";
        return "";
    }
    
    private int GetTotalColumnCount()
    {
        var count = _columns.Count(c => c.Visible);
        if (DetailTemplate != null) count++;
        if (SelectionMode != SbSelectionMode.None) count++;
        if (EditMode != SbEditMode.None && ShowEditActions) count++;
        return count;
    }
    
    private bool _isFirstRender = true;
    private bool _parametersChanged = false;
    private bool _suppressNextParameterRefresh;
    private IEnumerable<TItem>? _itemsAtLastRefresh;
    private Func<SbDataRequest, Task<SbDataResponse<TItem>>>? _itemsProviderAtLastRefresh;

    /// <summary>
    /// Client-owned page index. Prefer this over mutating the <see cref="PageIndex"/> parameter,
    /// so clicks stay correct while the parent catches up via <see cref="PageIndexChanged"/>.
    /// </summary>
    private int _pageIndex;
    private int _pageSize = 10;
    private int? _pendingPageIndex;
    private int? _pendingPageSize;
    
    protected override void OnInitialized()
    {
        _pageIndex = PageIndex;
        _pageSize = PageSize > 0 ? PageSize : 10;

        if (SelectedKeys != null)
        {
            _selectedKeys = new HashSet<string>(SelectedKeys);
        }
    }
    
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        SyncPagingParametersFromParent();
        
        if (SelectedKeys != null)
        {
            _selectedKeys = new HashSet<string>(SelectedKeys);
        }
        
        // Sync expanded rows with parameter
        if (ExpandedRowKeys != null)
        {
            _expandedRows = new HashSet<string>(ExpandedRowKeys);
        }

        var itemsChanged = !ReferenceEquals(Items, _itemsAtLastRefresh);
        var providerChanged = !ReferenceEquals(ItemsProvider, _itemsProviderAtLastRefresh);

        // After RefreshDataAsync we call StateHasChanged; that re-render must not loop.
        // But if Items/ItemsProvider identity changed on the same cycle (e.g. parent
        // finished LoadAsync while the empty first refresh was still suppressing),
        // honor the new data — otherwise the grid stays on "No data available"
        // until an unrelated UI event (topbar click) forces another parameter pass.
        if (_suppressNextParameterRefresh)
        {
            _suppressNextParameterRefresh = false;
            if (!itemsChanged && !providerChanged)
            {
                return;
            }
        }

        // Client mode after columns exist: apply Items immediately during this parameter
        // pass so async parent loads (MCP tools, copilots, etc.) paint without waiting for
        // OnAfterRenderAsync + suppress fencing.
        if (!_isFirstRender && !IsServerMode && itemsChanged)
        {
            LoadClientData();
            _itemsAtLastRefresh = Items;
            return;
        }

        _parametersChanged = true;
    }

    private void SyncPagingParametersFromParent()
    {
        if (_pendingPageIndex.HasValue)
        {
            if (PageIndex == _pendingPageIndex.Value)
            {
                _pendingPageIndex = null;
            }
            // Parent has not echoed the local change yet — keep _pageIndex.
        }
        else if (PageIndex != _pageIndex)
        {
            _pageIndex = PageIndex;
        }

        if (_pendingPageSize.HasValue)
        {
            if (PageSize == _pendingPageSize.Value)
            {
                _pendingPageSize = null;
            }
        }
        else if (PageSize != _pageSize && PageSize > 0)
        {
            _pageSize = PageSize;
        }
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _dotNetRef = DotNetObjectReference.Create(this);
        // Load data after render when columns are registered
        if (_isFirstRender || _parametersChanged)
        {
            _isFirstRender = false;
            _parametersChanged = false;
            await RefreshDataAsync();
            _itemsAtLastRefresh = Items;
            _itemsProviderAtLastRefresh = ItemsProvider;
            _suppressNextParameterRefresh = true;
            StateHasChanged();
        }
    }
    
    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        await ValueTask.CompletedTask;
    }
    
    /// <summary>
    /// Adds a column to the grid (called by SbColumn).
    /// </summary>
    internal void AddColumn(SbColumn<TItem> column)
    {
        if (!_columns.Contains(column))
        {
            _columns.Add(column);
            // Don't call StateHasChanged here - columns are registered during render.
            // Data will be loaded in OnAfterRenderAsync after columns are registered.
        }
    }
    
    /// <summary>
    /// Refreshes the data displayed in the grid.
    /// </summary>
    public async Task RefreshDataAsync()
    {
        if (IsServerMode)
        {
            await LoadServerDataAsync();
        }
        else
        {
            LoadClientData();
        }
    }
    
    private void LoadClientData()
    {
        if (Items == null)
        {
            _displayItems = new List<TItem>();
            _virtualizedItems = new();
            TotalCount = 0;
            return;
        }
        
        var items = Items.ToList();
        
        // Apply client-side filtering
        if (_activeFilters.Any())
        {
            items = ApplyClientFilters(items);
        }
        
        // Apply sorting
        if (_currentSort != null && !string.IsNullOrEmpty(_currentSort.Field))
        {
            var column = _columns.FirstOrDefault(c => c.Field == _currentSort.Field);
            if (column != null)
            {
                items = _currentSort.Direction == SbSortDirection.Ascending
                    ? items.OrderBy(item => column.GetValue(item)).ToList()
                    : items.OrderByDescending(item => column.GetValue(item)).ToList();
            }
        }
        
        // Hybrid anti-double-page: when parent already server/in-memory paged Items
        // (Items is one page of a larger TotalCount), do not Skip again or overwrite TotalCount.
        var effectivePageSize = _pageSize > 0 ? _pageSize : PageSize;
        var looksLikeAlreadyPagedSlice =
            ShowPagination &&
            effectivePageSize > 0 &&
            TotalCount > items.Count &&
            items.Count <= effectivePageSize;

        if (looksLikeAlreadyPagedSlice)
        {
            _displayItems = items;
            _virtualizedItems = new();
            return;
        }

        TotalCount = items.Count;
        
        // When virtualization is enabled, load all items (virtualization handles visible rows)
        // Otherwise, apply client-side pagination over the full Items set
        if (VirtualizationEnabled)
        {
            _displayItems = items;
            _virtualizedItems = items.Select((item, index) => (item, index)).ToList();
        }
        else if (ShowPagination && effectivePageSize > 0)
        {
            var pageIndex = Math.Max(0, _pageIndex);
            var maxPage = Math.Max(0, (int)Math.Ceiling(TotalCount / (double)effectivePageSize) - 1);
            if (pageIndex > maxPage)
            {
                pageIndex = maxPage;
                SetLocalPageIndex(pageIndex);
            }

            _displayItems = items
                .Skip(pageIndex * effectivePageSize)
                .Take(effectivePageSize)
                .ToList();
            _virtualizedItems = new();
        }
        else
        {
            _displayItems = items;
            _virtualizedItems = new();
        }
    }
    
    private List<TItem> ApplyClientFilters(List<TItem> items)
    {
        foreach (var filter in _activeFilters.Values)
        {
            var column = _columns.FirstOrDefault(c => c.Field == filter.Field);
            if (column == null) continue;
            
            items = items.Where(item => MatchesFilter(item, column, filter)).ToList();
        }
        
        return items;
    }
    
    private bool MatchesFilter(TItem item, SbColumn<TItem> column, SbFilter filter)
    {
        var value = column.GetValue(item);
        
        return filter.Operator switch
        {
            SbFilterOperator.IsNull => value == null,
            SbFilterOperator.IsNotNull => value != null,
            SbFilterOperator.Equals => Equals(value, filter.Value),
            SbFilterOperator.NotEquals => !Equals(value, filter.Value),
            SbFilterOperator.Contains => ContainsString(value, filter.Value),
            SbFilterOperator.StartsWith => StartsWithString(value, filter.Value),
            SbFilterOperator.EndsWith => EndsWithString(value, filter.Value),
            SbFilterOperator.GreaterThan => CompareValues(value, filter.Value) > 0,
            SbFilterOperator.GreaterThanOrEqual => CompareValues(value, filter.Value) >= 0,
            SbFilterOperator.LessThan => CompareValues(value, filter.Value) < 0,
            SbFilterOperator.LessThanOrEqual => CompareValues(value, filter.Value) <= 0,
            SbFilterOperator.Between => CompareValues(value, filter.Value) >= 0 && CompareValues(value, filter.Value2) <= 0,
            SbFilterOperator.In => IsInList(value, filter.Value),
            _ => true
        };
    }
    
    private static bool ContainsString(object? value, object? filterValue)
    {
        if (value == null || filterValue == null) return false;
        return value.ToString()?.Contains(filterValue.ToString() ?? "", StringComparison.OrdinalIgnoreCase) ?? false;
    }
    
    private static bool StartsWithString(object? value, object? filterValue)
    {
        if (value == null || filterValue == null) return false;
        return value.ToString()?.StartsWith(filterValue.ToString() ?? "", StringComparison.OrdinalIgnoreCase) ?? false;
    }
    
    private static bool EndsWithString(object? value, object? filterValue)
    {
        if (value == null || filterValue == null) return false;
        return value.ToString()?.EndsWith(filterValue.ToString() ?? "", StringComparison.OrdinalIgnoreCase) ?? false;
    }
    
    private static int CompareValues(object? value1, object? value2)
    {
        if (value1 == null && value2 == null) return 0;
        if (value1 == null) return -1;
        if (value2 == null) return 1;
        
        if (value1 is IComparable c1 && value2 is IComparable c2)
        {
            try { return c1.CompareTo(c2); } catch { }
            try { return c1.CompareTo(Convert.ChangeType(c2, value1.GetType())); } catch { }
        }
        
        return string.Compare(value1.ToString(), value2.ToString(), StringComparison.OrdinalIgnoreCase);
    }
    
    private static bool IsInList(object? value, object? filterValue)
    {
        if (value == null || filterValue == null) return false;
        var filterStr = filterValue.ToString();
        if (string.IsNullOrEmpty(filterStr)) return false;
        
        var items = filterStr.Split(',').Select(s => s.Trim());
        return items.Any(item => string.Equals(value.ToString(), item, StringComparison.OrdinalIgnoreCase));
    }
    
    private async Task LoadServerDataAsync()
    {
        if (ItemsProvider == null) return;
        
        var request = new SbDataRequest
        {
            PageIndex = _pageIndex,
            PageSize = _pageSize > 0 ? _pageSize : PageSize,
            Sorts = _currentSort != null ? new[] { _currentSort } : Array.Empty<SbSort>(),
            Filters = _activeFilters.Values.ToArray(),
            IncludeTotalCount = true
        };
        
        var response = await ItemsProvider(request);
        
        _displayItems = response.Items.ToList();
        
        if (VirtualizationEnabled)
        {
            _virtualizedItems = _displayItems.Select((item, index) => (item, index)).ToList();
        }
        else
        {
            _virtualizedItems = new();
        }

        TotalCount = response.TotalCount ?? _displayItems.Count;
    }
    
    private string GetItemKey(TItem item)
    {
        if (KeySelector != null)
        {
            return KeySelector(item);
        }
        
        // Fallback to hash code
        return item?.GetHashCode().ToString() ?? Guid.NewGuid().ToString();
    }
    
    private string GetColumnStyle(SbColumn<TItem> column)
    {
        var styles = new List<string>();
        
        if (!string.IsNullOrEmpty(column.Width))
            styles.Add($"width: {column.Width}");
        if (!string.IsNullOrEmpty(column.MinWidth))
            styles.Add($"min-width: {column.MinWidth}");
        if (!string.IsNullOrEmpty(column.MaxWidth))
            styles.Add($"max-width: {column.MaxWidth}");
        
        styles.Add($"text-align: {column.GetAlignStyle()}");
        
        if (!string.IsNullOrWhiteSpace(column.Style))
            styles.Add(column.Style.Trim());
        
        return string.Join("; ", styles);
    }
    
    private string GetSortIconClass(SbColumn<TItem> column)
    {
        if (_currentSort == null || _currentSort.Field != column.Field)
            return "sb-datagrid__sort-icon--none";
            
        return _currentSort.Direction == SbSortDirection.Ascending
            ? "sb-datagrid__sort-icon--asc"
            : "sb-datagrid__sort-icon--desc";
    }
    
    private string GetSortIconName(SbColumn<TItem> column)
    {
        if (_currentSort == null || _currentSort.Field != column.Field)
            return "sort-none";
            
        return _currentSort.Direction == SbSortDirection.Ascending ? "sort-asc" : "sort-desc";
    }
    
    private async Task OnHeaderClick(SbColumn<TItem> column)
    {
        if (!column.Sortable || string.IsNullOrEmpty(column.Field))
            return;
        
        if (_currentSort?.Field == column.Field)
        {
            // Toggle direction or clear
            if (_currentSort.Direction == SbSortDirection.Ascending)
            {
                _currentSort = new SbSort(column.Field, SbSortDirection.Descending);
            }
            else
            {
                _currentSort = null;
            }
        }
        else
        {
            _currentSort = new SbSort(column.Field, SbSortDirection.Ascending);
        }
        
        await OnSortChanged.InvokeAsync(_currentSort);
        await RefreshDataAsync();
    }
    
    private async Task OnRowClick(TItem item, string key)
    {
        await OnRowClicked.InvokeAsync(item);
        
        if (SelectionMode == SbSelectionMode.SingleRow)
        {
            _selectedKeys.Clear();
            _selectedKeys.Add(key);
            await SelectedKeysChanged.InvokeAsync(_selectedKeys);
            await SelectedItemsChanged.InvokeAsync(new List<TItem> { item });
        }
    }
    
    private async Task ToggleSelection(string key, TItem item)
    {
        if (SelectionMode == SbSelectionMode.SingleRow)
        {
            _selectedKeys.Clear();
            _selectedKeys.Add(key);
        }
        else if (SelectionMode == SbSelectionMode.MultipleRows)
        {
            if (_selectedKeys.Contains(key))
            {
                _selectedKeys.Remove(key);
            }
            else
            {
                _selectedKeys.Add(key);
            }
        }
        
        await SelectedKeysChanged.InvokeAsync(_selectedKeys);
        
        // Find all selected items for the callback
        if (Items != null)
        {
            var selectedItems = Items.Where(i => _selectedKeys.Contains(GetItemKey(i))).ToList();
            await SelectedItemsChanged.InvokeAsync(selectedItems);
        }
    }
    
    private async Task ToggleSelectAll()
    {
        if (IsAllSelected)
        {
            foreach (var item in _displayItems)
            {
                _selectedKeys.Remove(GetItemKey(item));
            }
        }
        else
        {
            foreach (var item in _displayItems)
            {
                _selectedKeys.Add(GetItemKey(item));
            }
        }
        
        await SelectedKeysChanged.InvokeAsync(_selectedKeys);
        
        if (Items != null)
        {
            var selectedItems = Items.Where(i => _selectedKeys.Contains(GetItemKey(i))).ToList();
            await SelectedItemsChanged.InvokeAsync(selectedItems);
        }
    }
    
    private void SetLocalPageIndex(int pageIndex)
    {
        _pageIndex = pageIndex;
        _pendingPageIndex = pageIndex;
        PageIndex = pageIndex;
    }

    private void SetLocalPageSize(int pageSize)
    {
        _pageSize = pageSize;
        _pendingPageSize = pageSize;
        PageSize = pageSize;
    }

    private async Task OnPageIndexChanged(int newIndex)
    {
        if (newIndex == _pageIndex)
        {
            return;
        }

        SetLocalPageIndex(newIndex);
        // Slice first so UI updates even if the parent handler is slow / no-op.
        await RefreshDataAsync();
        await PageIndexChanged.InvokeAsync(newIndex);
    }
    
    private async Task OnPageSizeChanged(int newSize)
    {
        if (newSize == _pageSize && _pageIndex == 0)
        {
            return;
        }

        SetLocalPageSize(newSize);
        SetLocalPageIndex(0);
        await RefreshDataAsync();
        await PageSizeChanged.InvokeAsync(newSize);
        await PageIndexChanged.InvokeAsync(0);
    }
    
    private async Task ToggleRowExpand(string key)
    {
        bool isExpanded;
        if (_expandedRows.Contains(key))
        {
            _expandedRows.Remove(key);
            isExpanded = false;
        }
        else
        {
            _expandedRows.Add(key);
            isExpanded = true;
        }
        
        await OnRowExpandChanged.InvokeAsync((key, isExpanded));
    }
    
    // ============ Editing Methods ============
    
    private async Task StartEditAsync(TItem item, int rowIndex)
    {
        if (item == null) return;
        try
        {
            var key = GetItemKey(item);
            var args = new SbRowEditEventArgs<TItem>(item, key, rowIndex);
            await OnRowEditing.InvokeAsync(args);
            if (!args.Cancel)
            {
                _editingRowKey = key;
                _editingColumnField = null;
                _editingItem = CloneItem(item);
                _gridEditContext = new EditContext(_editingItem!);
                _currentEditContext = new SbRowEditContext<TItem>(item, _editingItem, key, rowIndex);
                StateHasChanged();
            }
        }
        catch
        {
            ClearEditState();
            StateHasChanged();
        }
    }
    
    private async Task StartCellEditAsync(TItem item, int rowIndex, SbColumn<TItem> column)
    {
        if (item == null || column == null) return;
        try
        {
            var key = GetItemKey(item);
            var field = column.Field ?? "";
            var currentValue = column.GetValue(item);
            var args = new SbCellEditEventArgs<TItem>(item, key, rowIndex, field, currentValue, currentValue);
            await OnCellEditing.InvokeAsync(args);
            if (!args.Cancel)
            {
                _editingRowKey = key;
                _editingColumnField = column.Field;
                _editingItem = CloneItem(item);
                _gridEditContext = new EditContext(_editingItem!);
                _currentEditContext = new SbRowEditContext<TItem>(item, _editingItem, key, rowIndex);
                StateHasChanged();
            }
        }
        catch
        {
            ClearEditState();
            StateHasChanged();
        }
    }
    
    private async Task SaveEditAsync()
    {
        if (_editingRowKey == null || _editingItem == null || _currentEditContext == null) return;
        
        var originalItem = IsServerMode 
            ? _displayItems[_currentEditContext.RowIndex]
            : (Items ?? Enumerable.Empty<TItem>()).FirstOrDefault(i => GetItemKey(i) == _editingRowKey);
            
        if (originalItem != null)
        {
            // Map edited values back to the original item or a model
            var args = new SbRowEditCompletedEventArgs<TItem>(_editingItem, originalItem, _editingRowKey!, _currentEditContext.RowIndex, _currentEditContext.IsNewRow);
            await OnRowEdited.InvokeAsync(args);
            
            if (!args.Cancel)
            {
                // Update the item in the list
                UpdateItemInList(originalItem, _editingItem);
                ClearEditState();
                await RefreshDataAsync();
            }
        }
    }
    
    private async Task CancelEditAsync()
    {
        if (_editingRowKey == null) return;
        
        var originalItem = IsServerMode 
            ? _displayItems[_currentEditContext!.RowIndex]
            : (Items ?? Enumerable.Empty<TItem>()).FirstOrDefault(i => GetItemKey(i) == _editingRowKey);
            
        if (originalItem != null)
        {
            await OnRowEditCancelled.InvokeAsync(originalItem);
        }
        
        ClearEditState();
        StateHasChanged();
    }
    
    private TItem CloneItem(TItem item)
    {
        // Simple memberwise clone or serialization clone
        // For now, assume it's a simple object
        // NOTE: In a real library, we might use a more robust cloning mechanism
        return item; 
    }
    
    private void UpdateItemInList(TItem original, TItem edited)
    {
        // Copy properties from edited back to original
        // This is simplified and depends on the object structure
        var properties = typeof(TItem).GetProperties().Where(p => p.CanWrite);
        foreach (var prop in properties)
        {
            prop.SetValue(original, prop.GetValue(edited));
        }
    }
    
    private async Task OnCellValueChanged(SbColumn<TItem> column, object? newValue)
    {
        if (_editingItem == null || _currentEditContext == null) return;
        
        var oldValue = column.GetValue(_editingItem);
        column.SetValue(_editingItem, newValue);
        
        if (EditMode == SbEditMode.Cell)
        {
            var args = new SbCellEditEventArgs<TItem>(
                _editingItem,
                _editingRowKey ?? "",
                _currentEditContext.RowIndex,
                column.Field ?? "",
                oldValue,
                newValue
            );
            
            await OnCellEdited.InvokeAsync(args);
            
            if (!args.Cancel)
            {
                // In cell mode, save immediately after cell edit
                await SaveEditAsync();
            }
        }
    }
    
    private void ClearEditState()
    {
        _editingRowKey = null;
        _editingColumnField = null;
        _currentEditContext = null;
        _editingItem = default;
        _gridEditContext = null;
    }
    
    /// <summary>
    /// Gets the current edit context if available.
    /// </summary>
    public SbRowEditContext<TItem>? GetEditContext() => _currentEditContext;
    
    private async Task OnRowDoubleClick(TItem item, int rowIndex)
    {
        try
        {
            if (EditMode == SbEditMode.None) return;
            if (EditMode == SbEditMode.Row || EditMode == SbEditMode.Popup || EditMode == SbEditMode.Cell)
            {
                await StartEditAsync(item, rowIndex);
            }
        }
        catch (Exception)
        {
            // Prevent unhandled exception from terminating the circuit
            StateHasChanged();
        }
    }
    
    private async Task OnCellClick(TItem item, int rowIndex, SbColumn<TItem> column)
    {
        try
        {
            if (EditMode == SbEditMode.Cell && column.Editable && !IsEditingRow(GetItemKey(item)))
            {
                await StartCellEditAsync(item, rowIndex, column);
            }
        }
        catch (Exception)
        {
            StateHasChanged();
        }
    }
    
    private string? FormatDateForInput(object? value)
    {
        if (value == null) return null;
        
        if (value is DateTime dt)
            return dt.ToString("yyyy-MM-dd");
        if (value is DateOnly d)
            return d.ToString("yyyy-MM-dd");
        
        return value.ToString();
    }
    
    private static string FormatNumberForInput(object? value)
    {
        if (value == null) return "";
        return System.Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "";
    }
    
    private async Task OnCellValueChangedFromInput(SbColumn<TItem> column, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        var fieldType = column.GetFieldType();
        object? parsed = raw;
        
        if (!string.IsNullOrEmpty(raw))
        {
            var targetType = Nullable.GetUnderlyingType(fieldType) ?? fieldType;
            try
            {
                if (targetType == typeof(bool))
                    parsed = (e.Value is bool b) ? b : (bool.TryParse(raw, out var b2) ? b2 : false);
                else if (targetType == typeof(int))
                    parsed = int.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var i) ? i : (object?)null;
                else if (targetType == typeof(long))
                    parsed = long.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var l) ? l : (object?)null;
                else if (targetType == typeof(decimal))
                    parsed = decimal.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var m) ? m : (object?)null;
                else if (targetType == typeof(double))
                    parsed = double.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : (object?)null;
                else if (targetType == typeof(float))
                    parsed = float.TryParse(raw, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var f) ? f : (object?)null;
                else if (targetType == typeof(DateTime))
                    parsed = DateTime.TryParse(raw, out var dt) ? dt : (object?)null;
                else if (targetType == typeof(DateOnly))
                    parsed = DateOnly.TryParse(raw, out var d) ? d : (object?)null;
            }
            catch
            {
                parsed = raw;
            }
        }
        
        await OnCellValueChanged(column, parsed);
    }
    
    private object? ParseDateFromInput(object? value, Type targetType)
    {
        if (value == null || string.IsNullOrEmpty(value.ToString()))
            return null;
        
        var strValue = value.ToString()!;
        
        if (targetType == typeof(DateTime) || targetType == typeof(DateTime?))
        {
            if (DateTime.TryParse(strValue, out var dt))
                return dt;
        }
        else if (targetType == typeof(DateOnly) || targetType == typeof(DateOnly?))
        {
            if (DateOnly.TryParse(strValue, out var d))
                return d;
        }
        
        return value;
    }
    
