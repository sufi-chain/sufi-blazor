        };
    }
    
    private string GetRowStyle()
    {
        return $"height: {GetEffectiveRowHeight()}px";
    }
    
    // ============ CSV Export Methods ============
    
    /// <summary>
    /// Exports current display items to CSV format.
    /// </summary>
    public async Task ExportToCsvAsync(string filename = "export.csv")
    {
        var csv = new System.Text.StringBuilder();
        var visibleColumns = _columns.Where(c => c.Visible).ToList();
        
        // Header row
        csv.AppendLine(string.Join(",", visibleColumns.Select(c => EscapeCsvValue(c.Title))));
        
        // Data rows
        foreach (var item in _displayItems)
        {
            var values = visibleColumns.Select(c => EscapeCsvValue(c.GetDisplayValue(item)));
            csv.AppendLine(string.Join(",", values));
        }
        
        // Trigger download via JS
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        
        await JSRuntime.InvokeVoidAsync("SufiBlazor.dataGrid.downloadFile", filename, base64, "text/csv");
    }
    
    /// <summary>
    /// Exports all data (not just current page) to CSV format.
    /// </summary>
    public async Task ExportAllToCsvAsync(string filename = "export.csv")
    {
        IEnumerable<TItem> allItems;
        
        if (IsServerMode && ItemsProvider != null)
        {
            // Fetch all data from server
            var request = new SbDataRequest
            {
                PageIndex = 0,
                PageSize = int.MaxValue,
                Sorts = _currentSort != null ? new[] { _currentSort } : Array.Empty<SbSort>(),
                Filters = _activeFilters.Values.ToArray(),
                IncludeTotalCount = false
            };
            var response = await ItemsProvider(request);
            allItems = response.Items;
        }
        else
        {
            allItems = Items ?? Enumerable.Empty<TItem>();
        }
        
        var csv = new System.Text.StringBuilder();
        var visibleColumns = _columns.Where(c => c.Visible).ToList();
        
        // Header row
        csv.AppendLine(string.Join(",", visibleColumns.Select(c => EscapeCsvValue(c.Title))));
        
        // Data rows
        foreach (var item in allItems)
        {
            var values = visibleColumns.Select(c => EscapeCsvValue(c.GetDisplayValue(item)));
            csv.AppendLine(string.Join(",", values));
        }
        
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        
        await JSRuntime.InvokeVoidAsync("SufiBlazor.dataGrid.downloadFile", filename, base64, "text/csv");
    }
    
    private static string EscapeCsvValue(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return "";
        
        // Escape quotes and wrap in quotes if contains special characters
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n') || value.Contains('\r'))
        {
            return $"\"{value.Replace("\"", "\"\"")}\"";
        }
        
        return value;
    }
    
    private string GetFilterDisplayValue(SbFilter filter)
    {
        var opLabel = filter.Operator switch
        {
            SbFilterOperator.Equals => "=",
            SbFilterOperator.NotEquals => "≠",
            SbFilterOperator.Contains => "contains",
            SbFilterOperator.StartsWith => "starts with",
            SbFilterOperator.EndsWith => "ends with",
            SbFilterOperator.GreaterThan => ">",
            SbFilterOperator.GreaterThanOrEqual => "≥",
            SbFilterOperator.LessThan => "<",
            SbFilterOperator.LessThanOrEqual => "≤",
            SbFilterOperator.Between => "between",
            SbFilterOperator.IsNull => "is empty",
            SbFilterOperator.IsNotNull => "is not empty",
            _ => filter.Operator.ToString()
        };
        
        if (filter.Operator == SbFilterOperator.IsNull || filter.Operator == SbFilterOperator.IsNotNull)
            return opLabel;
        
        if (filter.Operator == SbFilterOperator.Between)
            return $"{opLabel} {filter.Value} and {filter.Value2}";
        
        return $"{opLabel} {filter.Value}";
    }

