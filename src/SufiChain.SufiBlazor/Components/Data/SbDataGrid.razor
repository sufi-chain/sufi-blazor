    // ============ Frozen Column Methods ============
    
    private string GetFrozenColumnClass(SbColumn<TItem> column)
    {
        return column.Freeze switch
        {
            SbColumnFreeze.Start => "sb-datagrid__cell--frozen-start",
            SbColumnFreeze.End => "sb-datagrid__cell--frozen-end",
            _ => ""
        };
    }
    
    private string GetColumnHeaderStyle(SbColumn<TItem> column, int colIndex, bool isHeader = true)
    {
        var styles = new List<string>();
        
        // Base column styles: prefer user-resized width, then column.Width
        if (_columnWidths.TryGetValue(column.Field ?? "", out var width))
            styles.Add($"width: {width}px");
        else if (!string.IsNullOrEmpty(column.Width))
            styles.Add($"width: {column.Width}");
            
        if (!string.IsNullOrEmpty(column.MinWidth))
            styles.Add($"min-width: {column.MinWidth}");
        else if (column.Freeze != SbColumnFreeze.None && !string.IsNullOrEmpty(column.Width))
            styles.Add($"min-width: {column.Width}"); // Prevent frozen columns from shrinking in responsive view
        if (!string.IsNullOrEmpty(column.MaxWidth))
            styles.Add($"max-width: {column.MaxWidth}");
        
        styles.Add($"text-align: {column.GetAlignStyle()}");
        
        if (!string.IsNullOrWhiteSpace(column.Style))
            styles.Add(column.Style.Trim());
        
        // Frozen column positioning: header gets higher z-index so it stacks above body when scrolling
        var frozenZIndex = isHeader ? 3 : 2;
        if (column.Freeze == SbColumnFreeze.Start)
        {
            var leftOffset = CalculateFrozenOffset(column, true);
            styles.Add($"position: sticky");
            styles.Add($"{(EffectiveRightToLeft ? "right" : "left")}: {leftOffset}px");
            styles.Add($"z-index: {frozenZIndex}");
        }
        else if (column.Freeze == SbColumnFreeze.End)
        {
            var rightOffset = CalculateFrozenOffset(column, false);
            styles.Add($"position: sticky");
            styles.Add($"{(EffectiveRightToLeft ? "left" : "right")}: {rightOffset}px");
            styles.Add($"z-index: {frozenZIndex}");
        }
        
        return string.Join("; ", styles);
    }
    
    private string GetColumnCellStyle(SbColumn<TItem> column, int colIndex)
    {
        return GetColumnHeaderStyle(column, colIndex, isHeader: false);
    }
    
    private int CalculateFrozenOffset(SbColumn<TItem> targetColumn, bool isStart)
    {
        var offset = 0;
        var visibleColumns = _columns.Where(c => c.Visible).ToList();
        
        if (isStart)
        {
            // Calculate offset from left for start-frozen columns
            foreach (var col in visibleColumns)
            {
                if (col == targetColumn) break;
                if (col.Freeze == SbColumnFreeze.Start)
                {
                    offset += GetColumnWidth(col);
                }
            }
        }
        else
        {
            // Calculate offset from right for end-frozen columns
            for (int i = visibleColumns.Count - 1; i >= 0; i--)
            {
                var col = visibleColumns[i];
                if (col == targetColumn) break;
                if (col.Freeze == SbColumnFreeze.End)
                {
                    offset += GetColumnWidth(col);
                }
            }
        }
        return offset;
    }
    
    private int GetColumnWidth(SbColumn<TItem> column)
    {
        if (_columnWidths.TryGetValue(column.Field ?? "", out var width))
            return width;
            
        if (!string.IsNullOrEmpty(column.Width) && int.TryParse(column.Width.Replace("px", ""), out var pWidth))
            return pWidth;
            
        return 150; // Default width if not specified
    }
    
    private static int ParseWidthPx(string? cssWidth, int fallback)
    {
        if (string.IsNullOrWhiteSpace(cssWidth)) return fallback;
        var s = cssWidth.Trim().Replace("px", "").Trim();
        return int.TryParse(s, out var v) ? v : fallback;
    }
    
    private int GetMinWidthPx(SbColumn<TItem> column)
    {
        return ParseWidthPx(column.MinWidth, 50);
    }
    
    private int GetMaxWidthPx(SbColumn<TItem> column)
    {
        return ParseWidthPx(column.MaxWidth, 2000);
    }
    
    private async Task StartColumnResize(MouseEventArgs e, SbColumn<TItem> column)
    {
        if (_dotNetRef == null || string.IsNullOrEmpty(column.Field)) return;
        _resizingColumn = column.Field;
        try
        {
            await JSRuntime.InvokeVoidAsync("SufiBlazor.dataGrid.startResize",
                _dotNetRef,
                column.Field,
                e.ClientX,
                GetColumnWidth(column),
                GetMinWidthPx(column).ToString(),
                GetMaxWidthPx(column).ToString());
        }
        catch (JSException)
        {
            _resizingColumn = null;
        }
    }
    
    [JSInvokable]
    public void OnColumnResizing(string field, int width)
    {
        _columnWidths[field] = width;
        StateHasChanged();
    }
    
    [JSInvokable]
    public void OnColumnResizeComplete(string field, int width)
    {
        _resizingColumn = null;
        _columnWidths[field] = width;
        InvokeAsync(async () =>
        {
            await OnColumnResized.InvokeAsync((field, width));
            StateHasChanged();
        });
    }
