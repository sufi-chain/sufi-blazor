@namespace SufiChain.SufiBlazor.Components.Feedback
@using Microsoft.Extensions.Localization
@using SufiChain.SufiBlazor.Localization
@inject IStringLocalizer<SufiBlazorResource> L
@implements IDisposable

<div class="@RootClass" aria-busy="@Busy.ToString().ToLowerInvariant()">
    @if (Announce)
    {
        <span class="sb-sr-only" role="status" aria-live="polite">@_announced</span>
    }
    @if (_showVisual)
    {
        <span class="sb-loading-skeleton__label" aria-hidden="true">@LabelText</span>
        <div class="sb-loading-skeleton__body" aria-hidden="true">
            @switch (Preset)
            {
                case SbLoadingSkeletonPreset.Kpi:
                    <div class="sb-loading-skeleton__kpis">
                        @for (var index = 0; index < SafeCount; index++)
                        {
                            <SbSkeleton Variant="SbSkeletonVariant.Rounded" Height="4.5rem" Animation="@Animation" />
                        }
                    </div>
                    break;
                case SbLoadingSkeletonPreset.Cards:
                    <div class="sb-loading-skeleton__cards">
                        @for (var index = 0; index < SafeCount; index++)
                        {
                            <SbSkeleton Variant="SbSkeletonVariant.Rounded" Height="5.5rem" Animation="@Animation" />
                        }
                    </div>
                    break;
                default:
                    <div class="sb-loading-skeleton__rows">
                        @for (var row = 0; row < SafeCount; row++)
                        {
                            <div class="sb-loading-skeleton__row">
                                @for (var cell = 0; cell < 3; cell++)
                                {
                                    <SbSkeleton Variant="SbSkeletonVariant.Text" Width="@(cell == 2 ? "55%" : "80%")" Animation="@Animation" />
                                }
                            </div>
                        }
                    </div>
                    break;
            }
        </div>
    }
    @if (ShowChild)
    {
        @ChildContent
    }
</div>
