@namespace SufiChain.SufiBlazor.Components.Common
@using SufiChain.SufiBlazor.Contracts.Editors
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@GetContainerClass()"
     style="@Style"
     dir="@ResolvedTextDirection"
     @attributes="AdditionalAttributes">
    @if (_useFallback)
    {
        <pre class="sb-document-viewer__fallback">@Content</pre>
    }
    else
    {
        <div @ref="_container" class="sb-document-viewer__content"></div>
    }
</div>
