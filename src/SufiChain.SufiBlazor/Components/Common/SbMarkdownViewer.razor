@namespace SufiChain.SufiBlazor.Components.Common
@using SufiChain.SufiBlazor.Interop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div @ref="_containerRef" class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (!_isClientRendered && !string.IsNullOrEmpty(Content))
    {
        <pre class="sb-markdown-viewer__fallback">@Content</pre>
    }
</div>
