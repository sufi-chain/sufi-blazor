@namespace SufiChain.SufiBlazor.Components.Builder

<div class="sb-inline-toolbar @(Visible ? "sb-inline-toolbar--visible" : "") @(Position.ToString().ToLower()) @Class"
     style="@GetPositionStyle()">
    @foreach (var action in Actions)
    {
        @if (action.IsSeparator)
        {
            <div class="sb-inline-toolbar__separator"></div>
        }
        else
        {
            <button type="button"
                    class="sb-inline-toolbar__btn @(action.IsActive ? "sb-inline-toolbar__btn--active" : "") @(action.IsDanger ? "sb-inline-toolbar__btn--danger" : "")"
                    title="@action.Tooltip"
                    disabled="@action.Disabled"
                    @onclick="() => OnActionClick(action)">
                @if (!string.IsNullOrEmpty(action.Icon))
                {
                    <span class="sb-inline-toolbar__icon">
                        <SbIcon Name="@action.Icon" Size="SbSize.Sm" />
                    </span>
                }
                else if (!string.IsNullOrEmpty(action.IconText))
                {
                    <span class="sb-inline-toolbar__icon">@action.IconText</span>
                }
                @if (!string.IsNullOrEmpty(action.Label))
                {
                    <span class="sb-inline-toolbar__label">@action.Label</span>
                }
            </button>
        }
    }
</div>

@code {
    /// <summary>
    /// Toolbar actions.
    /// </summary>
    [Parameter]
    public List<SbToolbarAction> Actions { get; set; } = new();
    
    /// <summary>
    /// Whether the toolbar is visible.
    /// </summary>
    [Parameter]
    public bool Visible { get; set; } = true;
    
    /// <summary>
    /// Toolbar position.
    /// </summary>
    [Parameter]
    public SbToolbarPosition Position { get; set; } = SbToolbarPosition.Top;
    
    /// <summary>
    /// X offset.
    /// </summary>
    [Parameter]
    public double? X { get; set; }
    
    /// <summary>
    /// Y offset.
    /// </summary>
    [Parameter]
    public double? Y { get; set; }
    
    /// <summary>
    /// Callback when action is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<SbToolbarAction> OnAction { get; set; }
    
    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }
    
    private string GetPositionStyle()
    {
        var styles = new List<string>();
        
        if (X.HasValue)
            styles.Add($"left: {X}px");
        if (Y.HasValue)
            styles.Add($"top: {Y}px");
            
        return string.Join("; ", styles);
    }
    
    private async Task OnActionClick(SbToolbarAction action)
    {
        if (action.Disabled) return;
        
        action.OnClick?.Invoke();
        await OnAction.InvokeAsync(action);
    }
}
