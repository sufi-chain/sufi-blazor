@namespace SufiChain.SufiBlazor.Components.Conversation
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

<div class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (HeaderContent != null)
    {
        <div class="sb-conversation-composer__header">
            @HeaderContent
        </div>
    }

    <div class="sb-conversation-composer__shell" @ref="_shellRef">
        @if (PendingContent != null)
        {
            <div class="sb-conversation-composer__pending">
                @PendingContent
            </div>
        }
        else if (PendingItems is { Count: > 0 })
        {
            <div class="sb-conversation-composer__pending">
                @foreach (var item in PendingItems)
                {
                    <span class="sb-conversation-composer__chip">
                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                        {
                            <SbIcon Name="@item.Icon" Size="SbSize.Sm" />
                        }
                        <span>@item.Label</span>
                        @if (OnRemovePending.HasDelegate)
                        {
                            <button type="button"
                                    class="sb-conversation-composer__chip-remove"
                                    @onclick="() => OnRemovePending.InvokeAsync(item)"
                                    aria-label="Remove">
                                ×
                            </button>
                        }
                    </span>
                }
            </div>
        }

        <div class="sb-conversation-composer__body sb-conversation-composer__actions">
            <div class="sb-conversation-composer__actions-start">
                @StartActions
                @OverflowActions
            </div>
            <div class="sb-conversation-composer__field" @onclick="FocusTextAreaAsync">
                <textarea @ref="_textAreaRef"
                          class="sb-conversation-composer__textarea"
                          rows="@Rows"
                          placeholder="@Placeholder"
                          disabled="@(IsDisabled || (ShowSendingState && RetainDraftWhileSending))"
                          value="@_domValue"
                          @oninput="HandleTextAreaInputAsync"></textarea>
            </div>
            <div class="sb-conversation-composer__actions-end">
                @EndActions
                @if (ShowDefaultSend)
                {
                    <SbIconButton Class="sb-conversation-composer__send"
                                  Color="SbColor.Primary"
                                  Size="SbSize.Sm"
                                  Loading="@ShowSendingState"
                                  Disabled="@(IsDisabled || !EffectiveCanSend)"
                                  OnClick="SendAsync"
                                  Title="@SendLabel"
                                  AriaLabel="@SendLabel">
                        <Icon><SbIcon Name="arrow-up" Size="SbSize.Sm" /></Icon>
                    </SbIconButton>
                }
            </div>
        </div>
    </div>

    @if (FooterContent != null)
    {
        <div class="sb-conversation-composer__footer">
            @FooterContent
        </div>
    }
</div>

@code {
   private ElementReference _shellRef;
   private ElementReference _textAreaRef;
   private string _draft = string.Empty;
   // sufi-chain#386: the value the server last wrote into the textarea. It changes only when
   // the host or the composer itself sets the text (initial value, clear after send, transcript),
   // never on typing. A server-bound value re-rendered on every keystroke and, on a slow circuit,
   // wrote back an older value over characters the user had typed since («ست ۱» for «تست ۱»).
   private string _domValue = string.Empty;
   private bool _domSyncPending;
   private string _lastParentValue = string.Empty;
   private bool _enterBound;
   private bool _enterBindStarted;
   private bool _submitting;
   private DotNetObjectReference<SbConversationComposer>? _dotNetRef;

   /// <summary>Draft text value.</summary>
   [Parameter]
   public string Value { get; set; } = string.Empty;

    /// <summary>Raised when draft text changes.</summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Placeholder text.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Textarea starting rows.</summary>
    [Parameter]
    public int Rows { get; set; } = 1;

    /// <summary>Disables the composer.</summary>
    [Parameter]
    public bool IsDisabled { get; set; }

    /// <summary>Shows a spinner on send and prevents submission while a request is pending.</summary>
    [Parameter]
    public bool IsSending { get; set; }

    /// <summary>
    /// Keeps the draft visible while send is in flight. The host clears it later by setting <see cref="Value"/> to empty.
    /// </summary>
    [Parameter]
    public bool RetainDraftWhileSending { get; set; }

    /// <summary>Host override for whether send is allowed. When null, derived from draft/pending.</summary>
    [Parameter]
    public bool? CanSend { get; set; }

    /// <summary>Shows the built-in send button.</summary>
    [Parameter]
    public bool ShowDefaultSend { get; set; } = true;

    /// <summary>Send button aria/title label.</summary>
    [Parameter]
    public string SendLabel { get; set; } = "Send";

    /// <summary>Optional UI capability hints.</summary>
    [Parameter]
    public SbConversationComposerCapabilities? Capabilities { get; set; }

    /// <summary>Default pending chips (when <see cref="PendingContent"/> is null).</summary>
    [Parameter]
    public IReadOnlyList<SbConversationPendingItem>? PendingItems { get; set; }

    /// <summary>Custom pending strip inside the composer card.</summary>
    [Parameter]
    public RenderFragment? PendingContent { get; set; }

    /// <summary>Leading tool cluster (emoji, attach, voice, …).</summary>
    [Parameter]
    public RenderFragment? StartActions { get; set; }

    /// <summary>Trailing cluster before send (shortcut popover, …).</summary>
    [Parameter]
    public RenderFragment? EndActions { get; set; }

    /// <summary>Leading overflow / AI addon cluster (model selector, context, …).</summary>
    [Parameter]
    public RenderFragment? OverflowActions { get; set; }

    /// <summary>Optional content above the shell (not a toolbar bar for addons).</summary>
    [Parameter]
    public RenderFragment? HeaderContent { get; set; }

    /// <summary>Optional content below the shell (busy text, hints).</summary>
    [Parameter]
    public RenderFragment? FooterContent { get; set; }

    /// <summary>Raised when send is requested.</summary>
    [Parameter]
    public EventCallback<SbConversationSendRequest> OnSend { get; set; }

    /// <summary>Raised when a default pending chip is removed.</summary>
    [Parameter]
    public EventCallback<SbConversationPendingItem> OnRemovePending { get; set; }

    /// <summary>Optional CSS class.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Optional inline style.</summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>Additional attributes.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>Shell element reference for host popovers/menus.</summary>
    public ElementReference ShellRef => _shellRef;

    /// <summary>Textarea element reference for host JS helpers.</summary>
    public ElementReference TextAreaRef => _textAreaRef;

    private bool ShowSendingState => IsSending || _submitting;

    private string CssClass
    {
        get
        {
            var css = ShowSendingState
                ? "sb-conversation-composer sb-conversation-composer--awaiting"
                : "sb-conversation-composer";
            return string.IsNullOrWhiteSpace(Class) ? css : $"{css} {Class}";
        }
    }

    private bool EffectiveCanSend =>
        CanSend ?? (!string.IsNullOrWhiteSpace(_draft) || (PendingItems?.Count > 0));

   protected override void OnParametersSet()
   {
       // Adopt external Value only when the parent actually changed it (clear after
       // send, AI suggest, programmatic set). Skip the input round-trip and skip
       // unrelated host re-renders so the textarea DOM/value is left alone while typing.
       var incoming = Value ?? string.Empty;
       if (!string.Equals(incoming, _lastParentValue, StringComparison.Ordinal))
       {
           _lastParentValue = incoming;
           // A two-way host echoes what was just typed. That is not a host edit, and
           // writing it back into the textarea would race keystrokes still in flight.
           if (!string.Equals(incoming, _draft, StringComparison.Ordinal))
           {
               SetTextFromHost(incoming);
           }
       }
   }

   /// <summary>
   /// Text set by the host or the composer (not typed). The render writes it as the value,
   /// and the DOM is also set through JS because an unchanged render value (for example two
   /// clears in a row) would not touch a textarea the user has typed into since.
   /// </summary>
   private void SetTextFromHost(string value)
   {
       if (string.Equals(value, _draft, StringComparison.Ordinal)
           && string.Equals(value, _domValue, StringComparison.Ordinal))
       {
           return;
       }

       _draft = value;
       _domValue = value;
       _domSyncPending = true;
   }

   protected override async Task OnAfterRenderAsync(bool firstRender)
   {
       if (_domSyncPending && !firstRender)
       {
           _domSyncPending = false;
           await SyncTextAreaDomAsync(_draft);
       }
       else if (firstRender)
       {
           // The first render already wrote the value attribute.
           _domSyncPending = false;
       }

       if (_enterBound || _enterBindStarted)
       {
           return;
       }

       // Claim the bind before the await. Blazor can run OnAfterRenderAsync again
       // while the first JS call is still in flight, and that second call would
       // attach a duplicate Enter handler.
       _enterBindStarted = true;
       try
       {
           _dotNetRef ??= DotNetObjectReference.Create(this);
           await JsRuntime.InvokeVoidAsync(
               "SufiBlazor.conversationComposer.bindEnterToSend",
               _textAreaRef,
               _dotNetRef,
               nameof(OnEnterSendAsync));
           _enterBound = true;
       }
       catch (JSDisconnectedException)
       {
           // The circuit is gone. A later interactive render can bind again.
           _enterBindStarted = false;
       }
       catch (JSException)
       {
           // The helper script is not ready yet. Retry on the next render.
           _enterBindStarted = false;
       }
       catch (InvalidOperationException)
       {
           // Static prerender. Retry on the next interactive render.
           _enterBindStarted = false;
       }
   }

   private async Task FocusTextAreaAsync()
   {
       if (IsDisabled || ShowSendingState)
       {
           return;
       }

       try
       {
           await _textAreaRef.FocusAsync();
       }
       catch (JSDisconnectedException)
       {
       }
       catch (InvalidOperationException)
       {
       }
   }

   private Task HandleTextAreaInputAsync(ChangeEventArgs args) =>
       HandleDraftInputAsync(args.Value?.ToString());

   private async Task HandleDraftInputAsync(string? value)
   {
       // Typing never changes _domValue, so the next render leaves the textarea alone.
       _draft = value ?? string.Empty;
       // Do not advance _lastParentValue here. Hosts that skip ValueChanged (to avoid
       // remounting) keep a stale Value; treating local typing as the parent value
       // would make the next empty parent Value look like an external clear.
       await ValueChanged.InvokeAsync(_draft);
   }

    /// <summary>Invoked from JS after Enter is preventDefaulted.</summary>
    [JSInvokable]
    public Task OnEnterSendAsync() => SendAsync();

    private async Task SendAsync()
    {
        if (IsDisabled || ShowSendingState || !EffectiveCanSend || !OnSend.HasDelegate)
        {
            return;
        }

        var body = _draft;
        var retainDraft = RetainDraftWhileSending;

        // Human chats clear before the host runs so Enter cannot resurrect the text.
        // Assistant chats keep the request visible until the host clears Value.
        if (!retainDraft)
        {
            _draft = string.Empty;
            _domValue = string.Empty;
            _lastParentValue = string.Empty;
            await SyncTextAreaDomAsync(string.Empty);
        }
        else
        {
            // The textarea already shows this text; keep the render value in step.
            _domValue = body;
        }

        _submitting = true;
        try
        {
            var request = new SbConversationSendRequest
            {
                Body = body
            };
            await OnSend.InvokeAsync(request);

            if (request.DraftAfterSend != null)
            {
                var next = request.DraftAfterSend;
                var typedDuringSend = !retainDraft && !string.Equals(next, _draft, StringComparison.Ordinal)
                    && string.IsNullOrEmpty(next) && !string.IsNullOrEmpty(_draft);
                if (typedDuringSend)
                {
                    // Human chats stay editable while sending. Keep the follow-up the user
                    // is already typing instead of wiping it with the host's empty draft.
                    _lastParentValue = string.Empty;
                }
                else if (!string.Equals(next, _draft, StringComparison.Ordinal))
                {
                    _draft = next;
                    _domValue = next;
                    _lastParentValue = next;
                    await SyncTextAreaDomAsync(next);
                    await ValueChanged.InvokeAsync(next);
                }
                else
                {
                    // Same text the browser already has (it came from input events).
                    // Writing it back would race keystrokes still in flight.
                    _domValue = next;
                    _lastParentValue = next;
                    await ValueChanged.InvokeAsync(next);
                }
            }
            else if (!retainDraft)
            {
                if (string.IsNullOrEmpty(_draft))
                {
                    _domValue = string.Empty;
                    _lastParentValue = string.Empty;
                    await ValueChanged.InvokeAsync(string.Empty);
                }
                else
                {
                    // Keep the follow-up typed while the send was running.
                    _lastParentValue = string.Empty;
                }
            }
        }
        catch
        {
            if (!retainDraft && string.IsNullOrEmpty(_draft))
            {
                _draft = body;
                _domValue = body;
                _lastParentValue = string.Empty;
                await SyncTextAreaDomAsync(body);
            }

            throw;
        }
        finally
        {
            _submitting = false;
            // The host often re-renders while this callback is still inside OnSend,
            // so that frame still sees _submitting. Queue another frame once the latch drops.
            StateHasChanged();
        }
    }

    private async Task SyncTextAreaDomAsync(string value)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("SufiBlazor.conversationComposer.setValue", _textAreaRef, value);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_enterBound)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("SufiBlazor.conversationComposer.unbindEnterToSend", _textAreaRef);
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }

            _enterBound = false;
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
