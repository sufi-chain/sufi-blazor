@namespace SufiChain.SufiBlazor.Components.Forms
@typeparam TItem
@typeparam TValue
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SufiBlazorResource> L

<div class="sb-select-anchor" @ref="_anchorRef">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sb-select__label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="sb-select__required" aria-hidden="true">*</span>
            }
        </label>
    }
    <div class="sb-select-trigger">
        <button type="button"
                class="sb-select-trigger__main"
                @onclick="Toggle"
                @onkeydown="HandleKeyDown"
                disabled="@Disabled"
                aria-haspopup="listbox"
                aria-expanded="@_isOpen"
                aria-labelledby="@Id">
            <span class="@(HasValue ? "sb-select-trigger__value" : "sb-select-trigger__placeholder")">
                @if (!HasValue)
                {
                    @(Placeholder ?? L["Select_Placeholder"])
                }
                else if (SelectedValueTemplate != null && TryFindSelectedItem(out var selectedForValueTemplate))
                {
                    @SelectedValueTemplate(selectedForValueTemplate)
                }
                else if (ItemTemplate != null && TryFindSelectedItem(out var selectedItem))
                {
                    @ItemTemplate(selectedItem)
                }
                else
                {
                    @GetDisplayText()
                }
            </span>
            @if (!(Clearable && HasValue && !Disabled))
            {
                <span class="@IconClass"><SbIcon Name="chevron-down" Size="SbSize.Sm" /></span>
            }
        </button>
        @if (Clearable && HasValue && !Disabled)
        {
            <button type="button"
                    class="sb-select-trigger__clear"
                    aria-label="@(L["Clear"])"
                    tabindex="-1"
                    @onclick="HandleClear"
                    @onclick:stopPropagation="true">
                <SbIcon Name="x" Size="SbSize.Sm" />
            </button>
            <span class="@IconClass"><SbIcon Name="chevron-down" Size="SbSize.Sm" /></span>
        }
    </div>

    @if (_isOpen)
    {
        <div class="@DropdownClass" role="listbox">
            @if (Searchable || SearchFunc != null)
            {
                <div class="sb-select-search">
                    <input type="text"
                           class="sb-select-search__input"
                           placeholder="@(SearchPlaceholder ?? L["Search_Placeholder"])"
                           @bind:get="_searchText"
                           @bind:set="OnSearchInputAsync"
                           @bind:event="oninput"
                           @ref="_searchRef" />
                </div>
            }
            <div class="sb-select-options">
                @if (_isLoading)
                {
                    <div class="sb-select-empty">
                        <span>@L["Loading"]</span>
                    </div>
                }
                else if (FilteredItems.Any())
                {
                    @foreach (var item in FilteredItems)
                    {
                        var itemValue = ValueField(item);
                        var isSelected = EqualityComparer<TValue>.Default.Equals(itemValue, Value);
                        <button type="button"
                                class="@GetOptionClass(isSelected)"
                                role="option"
                                aria-selected="@isSelected"
                                @onclick="() => SelectItem(item)">
                            @if (ItemTemplate != null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                @TextField(item)
                            }
                        </button>
                    }
                }
                else
                {
                    <div class="sb-select-empty">
                        @if (NoResultsTemplate != null)
                        {
                            @NoResultsTemplate
                        }
                        else
                        {
                            <span>@L["NoResultsFound"]</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>


@code {
    private ElementReference _anchorRef;
    private ElementReference _searchRef;
    private DotNetObjectReference<SbSelect<TItem, TValue>>? _dotNetRef;
    private bool _isOpen;
    private string _searchText = "";
    private bool _shouldFlip;
    private bool _isLoading;
    private List<TItem> _remoteItems = new();
    private TItem _selectedItem = default!;
    private bool _hasSelectedItem;
    private System.Timers.Timer? _debounceTimer;

    /// <summary>
    /// Selected value.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Callback when value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Items to select from.
    /// </summary>
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Function to get display text from item.
    /// </summary>
    [Parameter]
    public Func<TItem, string> TextField { get; set; } = item => item?.ToString() ?? "";

    /// <summary>
    /// Function to get value from item.
    /// </summary>
    [Parameter]
    public Func<TItem, TValue> ValueField { get; set; } = item => (TValue)(object)item!;

    /// <summary>
    /// Placeholder text when no selection. When null, uses localized default.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Whether the select is searchable.
    /// </summary>
    [Parameter]
    public bool Searchable { get; set; }

    /// <summary>
    /// Async function to fetch items based on search text. When set, search queries the backend instead of filtering local items only.
    /// </summary>
    [Parameter]
    public Func<string, Task<IEnumerable<TItem>>>? SearchFunc { get; set; }

    /// <summary>
    /// Minimum characters before remote search executes.
    /// </summary>
    [Parameter]
    public int MinLength { get; set; }

    /// <summary>
    /// Debounce delay in milliseconds for remote search.
    /// </summary>
    [Parameter]
    public int DebounceMs { get; set; } = 300;

    /// <summary>
    /// Maximum number of remote search results to show.
    /// </summary>
    [Parameter]
    public int MaxResults { get; set; } = 50;

    /// <summary>
    /// Placeholder text for the search input. When null, uses localized default.
    /// </summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }

    /// <summary>
    /// Whether the select allows clearing.
    /// </summary>
    [Parameter]
    public bool Clearable { get; set; }

    /// <summary>
    /// Whether the select is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Custom item template.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>
    /// Optional template for the closed/selected value display. When null, falls back to ItemTemplate then TextField.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? SelectedValueTemplate { get; set; }

    /// <summary>
    /// Template for no results.
    /// </summary>
    [Parameter]
    public RenderFragment? NoResultsTemplate { get; set; }

    /// <summary>
    /// Element ID for form association.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Label text displayed above the select.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Whether the field is required (shows asterisk).
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    private bool HasValue =>
        Value != null
        && (Items == null || !Items.Any()
            ? !EqualityComparer<TValue>.Default.Equals(Value, default)
            : Items.Any(item => EqualityComparer<TValue>.Default.Equals(ValueField(item), Value)));

    private string IconClass => $"sb-select-trigger__icon{(_isOpen ? " sb-select-trigger__icon--open" : "")}";

    private string DropdownClass => _shouldFlip ? "sb-select-dropdown sb-select-dropdown--flip-up" : "sb-select-dropdown";


    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (SearchFunc != null)
            {
                return _remoteItems;
            }

            if (Items == null)
            {
                return Enumerable.Empty<TItem>();
            }
            
            if (string.IsNullOrWhiteSpace(_searchText))
            {
                return Items;
            }

            return Items.Where(item => 
                TextField(item).Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string GetDisplayText()
    {
        if (Value == null)
        {
            return "";
        }

        if (TryFindSelectedItem(out var selectedItem))
        {
            return TextField(selectedItem);
        }

        return "";
    }

    private bool TryFindSelectedItem(out TItem item)
    {
        if (_hasSelectedItem &&
            EqualityComparer<TValue>.Default.Equals(ValueField(_selectedItem), Value))
        {
            item = _selectedItem;
            return true;
        }

        if (Items != null)
        {
            foreach (var candidate in Items)
            {
                if (EqualityComparer<TValue>.Default.Equals(ValueField(candidate), Value))
                {
                    item = candidate;
                    return true;
                }
            }
        }

        foreach (var candidate in _remoteItems)
        {
            if (EqualityComparer<TValue>.Default.Equals(ValueField(candidate), Value))
            {
                item = candidate;
                return true;
            }
        }

        item = default!;
        return false;
    }

    private async Task OnSearchInputAsync(string? value)
    {
        _searchText = value ?? string.Empty;

        if (SearchFunc == null)
        {
            StateHasChanged();
            return;
        }

        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();

        if (DebounceMs <= 0)
        {
            await PerformRemoteSearchAsync();
            return;
        }

        _debounceTimer = new System.Timers.Timer(DebounceMs);
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await PerformRemoteSearchAsync();
                StateHasChanged();
            });
        };
        _debounceTimer.Start();
    }

    private async Task PerformRemoteSearchAsync()
    {
        if (SearchFunc == null)
        {
            return;
        }

        if (_searchText.Length < MinLength)
        {
            _remoteItems.Clear();
            StateHasChanged();
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var results = await SearchFunc(_searchText);
            _remoteItems = results.Take(MaxResults).ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (Value == null)
        {
            _hasSelectedItem = false;
            return;
        }

        if (_hasSelectedItem &&
            EqualityComparer<TValue>.Default.Equals(ValueField(_selectedItem), Value))
        {
            return;
        }

        if (TryFindSelectedItem(out var item))
        {
            _selectedItem = item;
            _hasSelectedItem = true;
        }
        else
        {
            _hasSelectedItem = false;
        }
    }

    private string GetOptionClass(bool isSelected)
    {
        var classes = new List<string> { "sb-select-option" };
        if (isSelected)
        {
            classes.Add("sb-select-option--selected");
        }
        return string.Join(" ", classes);
    }

    private async Task Toggle()
    {
        if (Disabled) return;
        
        _isOpen = !_isOpen;
        _searchText = "";

        if (_isOpen)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.register", _anchorRef, _dotNetRef, "OnClickAway");
            
            // Check if dropdown should flip up
            _shouldFlip = await JSRuntime.InvokeAsync<bool>("SufiBlazor.select.shouldFlipUp", _anchorRef, 300);

            if (SearchFunc != null)
            {
                await PerformRemoteSearchAsync();
            }

            StateHasChanged();
        }
        else
        {
            _shouldFlip = false;
            await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.unregister", _anchorRef);
        }
    }


    private async Task SelectItem(TItem item)
    {
        _selectedItem = item;
        _hasSelectedItem = true;
        var value = ValueField(item);
        await ValueChanged.InvokeAsync(value);
        _isOpen = false;
        _searchText = "";
        await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.unregister", _anchorRef);
    }

    private async Task HandleClear()
    {
        if (Disabled || !Clearable)
        {
            return;
        }

        _hasSelectedItem = false;
        _selectedItem = default!;
        _searchText = "";
        await ValueChanged.InvokeAsync(default);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _isOpen)
        {
            _isOpen = false;
            await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.unregister", _anchorRef);
        }
        else if (args.Key is "Enter" or " " or "ArrowDown" && !_isOpen)
        {
            await Toggle();
        }
    }

    [JSInvokable]
    public async Task OnClickAway()
    {
        if (_isOpen)
        {
            _isOpen = false;
            _searchText = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _debounceTimer?.Dispose();
    }
}
