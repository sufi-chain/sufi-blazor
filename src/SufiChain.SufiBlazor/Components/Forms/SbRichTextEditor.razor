    private RteToolbarActionContext CreateActionContext()
    {
        var context = new RteToolbarActionContext(_editorId!, ServiceProvider);
        
        // Wire up the action delegates
        context.InsertHtmlAsync = async (html) =>
        {
            if (_editorInterop != null)
            {
                await _editorInterop.InsertHtmlAsync(_editorId!, html);
            }
        };
        
        context.InsertImageAsync = async (url, alt) =>
        {
            if (_editorInterop != null)
            {
                await _editorInterop.InsertImageAsync(_editorId!, url, alt);
            }
        };
        
        context.InsertLinkAsync = async (url, text) =>
        {
            if (_editorInterop != null)
            {
                await _editorInterop.InsertLinkAsync(_editorId!, url, text);
            }
        };
        
        context.GetHtmlAsync = async () =>
        {
            if (_editorInterop != null)
            {
                return await _editorInterop.GetContentAsync(_editorId!, SbEditorMode.Html);
            }
            return null;
        };
        
        context.GetSelectionAsync = async () =>
        {
            if (_editorInterop != null)
            {
                return await _editorInterop.GetSelectionTextAsync(_editorId!);
            }
            return null;
        };
        
        return context;
    }
    
    private async Task OnSelectFormatAsync(string format, ChangeEventArgs e)
    {
        if (_editorInterop == null || string.IsNullOrEmpty(_editorId))
            return;
            
        var value = e.Value?.ToString();
        object? formatValue = value switch
        {
            "" or "false" or "False" => false,
            "true" or "True" => true,
            _ when int.TryParse(value, out var intVal) => intVal,
            _ => value
        };
        
        await _editorInterop.FormatAsync(_editorId, format, formatValue);
    }
    
    private string GetOptionLabel(SbEditorToolbarOption option)
    {
        if (!string.IsNullOrEmpty(option.LabelKey))
            return L[option.LabelKey];
        return option.Label ?? "";
    }
    
    private bool IsFormatActive(string? format)
    {
        if (string.IsNullOrEmpty(format))
            return false;
        if (!_activeFormats.TryGetValue(format, out var val) || val == null)
            return false;
        if (val is bool b)
            return b;
        if (val is string s)
            return !string.IsNullOrEmpty(s);
        return true;
    }
    
    /// <summary>
    /// Gets the current value for a select-format toolbar item (align, header) for binding the dropdown.
    /// In RTL mode, align defaults to "right" when no explicit alignment is set.
    /// </summary>
    private string GetSelectFormatValue(SbEditorToolbarItem item)
    {
        if (item.Options == null || string.IsNullOrEmpty(item.Format))
            return "";
        if (!_activeFormats.TryGetValue(item.Format, out var raw))
            return GetSelectFormatValueDefault(item, null);
        var value = raw;
        if (value is JsonElement je)
        {
            value = je.ValueKind switch
            {
                JsonValueKind.False => false,
                JsonValueKind.True => true,
                JsonValueKind.String => je.GetString(),
                JsonValueKind.Number => je.TryGetInt32(out var i) ? i : je.GetDouble(),
                _ => value
            };
        }
        return GetSelectFormatValueDefault(item, value);
    }
    
    private string GetSelectFormatValueDefault(SbEditorToolbarItem item, object? value)
    {
        // Option values use ToString(): false -> "False", "right" -> "right", etc.
        var str = value == null ? "" : value.ToString() ?? "";
        if (item.Id == "align")
        {
            var isUnsetOrLeft = string.IsNullOrEmpty(str) || str == "False";
            if (isUnsetOrLeft && EffectiveRightToLeft)
                return "right";
            if (isUnsetOrLeft)
                return "False"; // Left option has Value = false -> "False"
        }
        // Font: when no font applied, show Default (Value = false -> "False")
        if (item.Id == "font" && string.IsNullOrEmpty(str))
            return "False";
        // Header: when no heading applied, show Normal (Value = false -> "False")
        if (item.Id == "header" && string.IsNullOrEmpty(str))
            return "False";
        return str;
    }
    
    /// <summary>
    /// Called from JavaScript when the editor content changes.
    /// </summary>
    [JSInvokable]
    public async Task OnEditorChangeAsync(string html, string text)
    {
        var newValue = Mode switch
        {
            SbEditorMode.Html => html,
            SbEditorMode.PlainText => text,
            SbEditorMode.Markdown => await GetMarkdownContentAsync() ?? html,
            _ => html
        };
        
        // Update tracking to prevent re-sync in OnParametersSetAsync
        _previousValue = newValue;
        Value = newValue;
        
        _charCount = text?.Length ?? 0;
        _wordCount = string.IsNullOrWhiteSpace(text) ? 0 : text.Split(new[] { ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;
        
        await ValueChanged.InvokeAsync(Value);
        await OnChange.InvokeAsync(Value);
        StateHasChanged();
    }
    
