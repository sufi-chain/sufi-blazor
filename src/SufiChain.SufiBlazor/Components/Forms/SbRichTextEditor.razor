    private string GetContainerClass()
    {
        var classes = new List<string> { "sb-editor" };
        
        if (Disabled) classes.Add("sb-editor--disabled");
        if (ReadOnly) classes.Add("sb-editor--readonly");
        if (EffectiveRightToLeft) classes.Add("sb-editor--rtl");
        if (!string.IsNullOrEmpty(Class)) classes.Add(Class);
        
        return string.Join(" ", classes);
    }
    
    private string? GetContainerStyle()
    {
        if (string.IsNullOrEmpty(Height))
            return null;
        return $"--sb-editor-height: {Height};";
    }
    
    public async ValueTask DisposeAsync()
    {
        if (_editorInterop != null)
        {
            if (!string.IsNullOrEmpty(_editorId))
            {
                try
                {
                    await _editorInterop.DestroyEditorAsync(_editorId);
                }
                catch (JSDisconnectedException)
                {
                    // Circuit disconnected, ignore
                }
                catch (ObjectDisposedException)
                {
                    // Already disposed, ignore
                }
                catch
                {
                    // Ignore other disposal errors
                }
            }
            
            try
            {
                await _editorInterop.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit disconnected, ignore
            }
            catch (ObjectDisposedException)
            {
                // Already disposed, ignore
            }
            catch
            {
                // Ignore other disposal errors
            }
        }
        
        _dotNetRef?.Dispose();
    }
