    private async Task ApplyLinkAsync()
    {
        if (_editorInterop == null || string.IsNullOrEmpty(_editorId))
            return;
        
        var url = _linkUrl?.Trim() ?? "";
        if (string.IsNullOrEmpty(url))
            return;
        
        // When there is a selection, apply link to selection (pass null for text).
        // When there is no selection, insert link with optional text (or URL as text).
        var text = _linkHasSelection ? null : (_linkText?.Trim());
        var target = string.IsNullOrWhiteSpace(_linkTarget) ? null : _linkTarget.Trim();
        var rel = string.IsNullOrWhiteSpace(_linkRel) ? null : _linkRel.Trim();
        await _editorInterop.InsertLinkAsync(_editorId, url, text, target, rel);
        
        _linkDialogOpen = false;
        _linkUrl = "";
        _linkText = "";
        _linkTarget = "";
        _linkRel = "";
        await InvokeAsync(StateHasChanged);
    }
    
