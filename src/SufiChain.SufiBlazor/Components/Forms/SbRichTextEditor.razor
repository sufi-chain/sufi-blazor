@namespace SufiChain.SufiBlazor.Components.Forms
@using SufiChain.SufiBlazor.Components.Actions
@using SufiChain.SufiBlazor.Components.Forms.Editor
@using SufiChain.SufiBlazor.Components.Layout
@using SufiChain.SufiBlazor.Components.Overlays
@using SufiChain.SufiBlazor.Contracts.Editors
@using SufiChain.SufiBlazor.Localization
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<SufiBlazorResource> L

<div class="sb-editor-host">
<div class="@GetContainerClass()"
     style="@GetContainerStyle()"
     dir="@(EffectiveRightToLeft ? "rtl" : "ltr")">
    @if (!HideToolbar && Mode != SbEditorMode.ReadOnly)
    {
        <SbEditorToolbar Items="_toolbarItems"
                         State="_state"
                         Disabled="@(Disabled || ReadOnly)"
                         AriaLabel="@ToolbarAriaLabel"
                         Class="sb-editor__toolbar--main"
                         Localizer="L"
                         OnItemClick="OnToolbarItemClickAsync"
                         OnSelectChanged="OnToolbarSelectChangedAsync" />
    }

    @if (_useFallback)
    {
        <SbTextArea Value="@Value"
                    ValueChanged="OnFallbackValueChangedAsync"
                    Rows="8"
                    Placeholder="@Placeholder"
                    Disabled="@Disabled"
                    ReadOnly="@(ReadOnly || Mode == SbEditorMode.ReadOnly)"
                    Class="sb-editor__fallback" />
    }
    else
    {
        <div @ref="_editorContainer"
             class="sb-editor__content"
             role="textbox"
             aria-multiline="true"
             aria-label="@(Placeholder ?? EditorAriaLabel)"
             aria-readonly="@((ReadOnly || Mode == SbEditorMode.ReadOnly) ? "true" : "false")"
             aria-disabled="@(Disabled ? "true" : "false")"></div>
        @if (ShowBubbleMenu)
        {
            <div @ref="_bubbleMenu"
                 class="sb-editor__bubble-menu"
                 style="display: none; position: absolute;">
                <SbEditorToolbar Items="_bubbleItems"
                                 State="_state"
                                 Disabled="@(Disabled || ReadOnly)"
                                 AriaLabel="@BubbleMenuAriaLabel"
                                 Class="sb-editor__toolbar--bubble"
                                 Localizer="L"
                                 OnItemClick="OnToolbarItemClickAsync"
                                 OnSelectChanged="OnToolbarSelectChangedAsync" />
            </div>
        }
        @if (ShowSlashMenu)
        {
            <SbButton Size="SbSize.Sm"
                      Variant="SbButtonVariant.Ghost"
                      Class="sb-editor__slash-trigger"
                      AriaLabel="@SlashMenuAriaLabel"
                      OnClick="ToggleSlashMenu">
                +
            </SbButton>
            <SbEditorSlashMenu Open="_slashMenuOpen"
                               Items="_slashItems"
                               AriaLabel="@SlashMenuAriaLabel"
                               OnItemClick="OnSlashItemClickAsync" />
        }
    }

    @if (ShowCharacterCount || ShowWordCount)
    {
        <SbEditorFooter WordCount="_state.WordCount"
                        CharacterCount="_state.CharacterCount"
                        ShowWordCount="ShowWordCount"
                        ShowCharacterCount="ShowCharacterCount"
                        WordCountFormat="@WordCountFormat"
                        CharacterCountFormat="@CharacterCountFormat" />
    }
</div>

<SbEditorAiReviewBar Visible="_suggestions.Count > 0"
                     ShowBatchActions="@(_suggestions.Count > 1)"
                     Style="@_suggestionBarStyle"
                     AriaLabel="@L["Editor:SuggestionReview"]"
                     AcceptText="@L["Editor:Accept"]"
                     RejectText="@L["Editor:Reject"]"
                     DismissText="@L["Editor:Dismiss"]"
                     AcceptAllText="@L["Editor:AcceptAll"]"
                     RejectAllText="@L["Editor:RejectAll"]"
                     OnAccept="AcceptCurrentSuggestionAsync"
                     OnReject="RejectCurrentSuggestionAsync"
                     OnDismiss="RejectAllSuggestionsAsync"
                     OnAcceptAll="AcceptAllSuggestionsAsync"
                     OnRejectAll="RejectAllSuggestionsAsync" />
</div>

<SbEditorAiMenu Open="_aiMenuOpen"
                OpenChanged="OnAiMenuOpenChanged"
                Prompt="_aiPrompt"
                PromptChanged="OnAiPromptChanged"
                StatusText="@_aiStatus"
                OnSubmit="OnAiSubmitAsync"
                OnCancel="CloseAiMenu" />

<SbDialog Open="_linkDialogOpen"
          OpenChanged="OnLinkDialogOpenChanged"
          Title="@LinkDialogTitle"
          Size="SbDialogSize.Sm">
    <ChildContent>
        <div class="sb-editor__link-dialog">
            <div class="sb-editor__link-dialog-field">
                <label for="rte-link-url">@UrlLabel</label>
                <input id="rte-link-url" type="url" class="sb-editor__link-input" placeholder="https://" @bind="_linkUrl" />
            </div>
            <div class="sb-editor__link-dialog-field">
                <label for="rte-link-text">@LinkTextLabel</label>
                <input id="rte-link-text" type="text" class="sb-editor__link-input" @bind="_linkText" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="CloseLinkDialogAsync">@(CancelText ?? L["Cancel"])</SbButton>
            <SbButton Variant="SbButtonVariant.Solid" OnClick="ApplyLinkAsync">@(ApplyText ?? L["Apply"])</SbButton>
        </SbStack>
    </Footer>
</SbDialog>

<SbDialog Open="_imageDialogOpen"
          OpenChanged="OnImageDialogOpenChanged"
          Title="@ImageDialogTitle"
          Size="SbDialogSize.Sm">
    <ChildContent>
        <div class="sb-editor__link-dialog">
            <div class="sb-editor__link-dialog-field">
                <label for="rte-image-url">@ImageUrlLabel</label>
                <input id="rte-image-url" type="url" class="sb-editor__link-input" placeholder="https://" @bind="_imageUrl" />
            </div>
            <div class="sb-editor__link-dialog-field">
                <label for="rte-image-alt">@AltTextLabel</label>
                <input id="rte-image-alt" type="text" class="sb-editor__link-input" @bind="_imageAlt" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <SbStack Direction="SbStackDirection.Row" Gap="2" Justify="SbJustify.End">
            <SbButton Variant="SbButtonVariant.Outline" OnClick="CloseImageDialogAsync">@(CancelText ?? L["Cancel"])</SbButton>
            <SbButton Variant="SbButtonVariant.Solid" OnClick="ApplyImageAsync">@InsertText</SbButton>
        </SbStack>
    </Footer>
</SbDialog>
