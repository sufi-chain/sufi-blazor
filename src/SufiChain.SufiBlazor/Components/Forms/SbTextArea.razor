@namespace SufiChain.SufiBlazor.Components.Forms
@using SufiChain.SufiBlazor.Components.Forms.Internal
@inject IJSRuntime JsRuntime

<div class="sb-textarea @(Error ? "sb-textarea--error" : "") @(Disabled ? "sb-textarea--disabled" : "") @(ReadOnly ? "sb-textarea--readonly" : "") @Class" style="@Style">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sb-textarea__label" for="@EffectiveId">
            @Label
            @if (Required)
            {
                <span class="sb-textarea__required" aria-hidden="true">*</span>
            }
        </label>
    }
    <textarea @ref="_inputRef"
              class="sb-textarea__input"
              value="@_sync.DomValue"
              @oninput="OnInputAsync"
              @onchange="OnChangeAsync"
              placeholder="@Placeholder"
              disabled="@Disabled"
              readonly="@ReadOnly"
              rows="@Rows"
              maxlength="@MaxLength"
              aria-invalid="@(Error || FormFieldContext?.HasError == true ? "true" : null)"
              aria-required="@(Required || FormFieldContext?.Required == true ? "true" : null)"
              aria-describedby="@AriaDescribedBy"
              id="@EffectiveId"
              @attributes="AdditionalAttributes"></textarea>
    
    @if (!string.IsNullOrEmpty(HelperText) && !Error)
    {
        <div class="sb-textarea__helper" id="@(EffectiveId)-helper">@HelperText</div>
    }
    @if (Error && !string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="sb-textarea__error" id="@(EffectiveId)-error" role="alert">@ErrorMessage</div>
    }
    
    @if (ShowCharacterCount && MaxLength.HasValue)
    {
        <div class="sb-textarea__counter">
            @(_sync.Draft.Length) / @MaxLength
        </div>
    }
    
    @if (Resizable)
    {
        <div class="sb-textarea__resize-handle"></div>
    }
</div>

@code {
    private ElementReference _inputRef;

    // sufi-chain#533: shared draft/stale-parent guard. The textarea renders _sync.DomValue, which
    // only a genuine host set or a component action changes, so a lagging parent render cannot
    // overwrite characters typed since.
    private readonly SbTextInputSync _sync = new();

    /// <summary>
    /// The current text value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Text held by the control, including input that has not yet round-tripped to the parent.
    /// </summary>
    public string? CurrentText => _sync.Draft;

    /// <summary>
    /// Text currently shown in the browser, including keystrokes that have not yet updated <see cref="CurrentText"/>.
    /// </summary>
    public async Task<string?> GetCommittedValueAsync()
    {
        var fromDom = await TryReadDomValueAsync();
        if (fromDom != null)
        {
            await CommitValueAsync(fromDom);
            return _sync.Draft;
        }

        return _sync.Draft;
    }
    
    /// <summary>
    /// Callback when value changes.
    /// </summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }
    
    /// <summary>
    /// Placeholder text.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }
    
    /// <summary>
    /// Number of visible text rows.
    /// </summary>
    [Parameter]
    public int Rows { get; set; } = 3;
    
    /// <summary>
    /// Maximum character length.
    /// </summary>
    [Parameter]
    public int? MaxLength { get; set; }
    
    /// <summary>
    /// Whether to show character count.
    /// </summary>
    [Parameter]
    public bool ShowCharacterCount { get; set; }
    
    /// <summary>
    /// Whether the textarea is resizable.
    /// </summary>
    [Parameter]
    public bool Resizable { get; set; } = true;
    
    /// <summary>
    /// Whether the textarea is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }
    
    /// <summary>
    /// Whether the textarea is read-only.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }
    
    /// <summary>
    /// Whether the textarea has an error.
    /// </summary>
    [Parameter]
    public bool Error { get; set; }
    
    /// <summary>
    /// Element ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Label text displayed above the textarea.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Whether the field is required (shows asterisk).
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Helper or hint text shown below the textarea (hidden when Error is true).
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// Error message shown when Error is true.
    /// </summary>
    [Parameter]
    public string? ErrorMessage { get; set; }
    
    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Inline styles for the wrapper element.
    /// </summary>
    [Parameter]
    public string? Style { get; set; }
    
    /// <summary>
    /// Additional HTML attributes.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string EffectiveId => Id ?? FormFieldContext?.InputId ?? _generatedId;
    private readonly string _generatedId = $"sb-textarea-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        _sync.ObserveParent(Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A component action can leave the rendered value identical, so the DOM has to be written
        // explicitly. Typing never sets this flag, so it costs nothing while typing.
        if (_sync.DomSyncPending)
        {
            _sync.MarkDomSynced();
            await SyncDomValueAsync(_sync.Draft);
        }
    }

    private async Task SyncDomValueAsync(string value)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("SufiBlazor.textInput.setValue", _inputRef, value);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            // Static prerender or a torn-down circuit. The rendered value still matches.
        }
    }

    private string? AriaDescribedBy
    {
        get
        {
            if (Error && !string.IsNullOrEmpty(ErrorMessage))
                return $"{FormFieldContext?.DescriptionId} {EffectiveId}-error".Trim();
            if (!string.IsNullOrEmpty(HelperText) && !Error)
                return $"{FormFieldContext?.DescriptionId} {EffectiveId}-helper".Trim();
            return FormFieldContext?.DescriptionId;
        }
    }
    
    private Task OnInputAsync(ChangeEventArgs args)
    {
        return CommitValueAsync(args.Value?.ToString());
    }

    private Task OnChangeAsync(ChangeEventArgs args)
    {
        return CommitValueAsync(args.Value?.ToString());
    }

    private async Task CommitValueAsync(string? value)
    {
        if (!_sync.WriteInput(value))
        {
            return;
        }

        await ValueChanged.InvokeAsync(_sync.Draft);
    }

    private async Task<string?> TryReadDomValueAsync()
    {
        try
        {
            return await JsRuntime.InvokeAsync<string?>("SufiBlazor.readControlValue", _inputRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
        {
            return null;
        }
    }
}
