@namespace SufiChain.SufiBlazor.Components.Forms
@using SufiChain.SufiBlazor.Components.Common
@typeparam TItem
@typeparam TValue
@implements IDisposable
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SufiBlazorResource> L

<div class="sb-select-anchor sb-multi-select-anchor @Class" @ref="_anchorRef">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="sb-multi-select__label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="sb-multi-select__required" aria-hidden="true">*</span>
            }
        </label>
    }
    <div class="@TriggerCssClass" style="@Style" @onclick="Toggle" tabindex="0" @onkeydown="HandleKeyDown">
        @if (Values?.Any() == true)
        {
            @foreach (var value in Values)
            {
                var item = GetItemByValue(value);
                <span class="sb-multi-select__chip">
                    @if (item != null)
                    {
                        if (ChipTemplate != null)
                        {
                            @ChipTemplate(item)
                        }
                        else if (ItemTemplate != null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            @TextField(item)
                        }
                    }
                    <button type="button" 
                            class="sb-multi-select__chip-remove"
                            @onclick:stopPropagation="true"
                            @onclick="() => RemoveValue(value)"
                            aria-label="@(RemoveAriaLabel ?? L["Remove"])">
                        <SbIcon Name="x" Size="SbSize.Sm" />
                    </button>
                </span>
            }
        }
        else
        {
            <span class="sb-multi-select__placeholder">@(Placeholder ?? L["Select_Placeholder"])</span>
        }
    </div>

    @if (_isOpen)
    {
        <div class="@DropdownClass" role="listbox" aria-multiselectable="true">
            @if (Searchable || SearchFunc != null)
            {
                <div class="sb-select-search">
                    <input type="text"
                           class="sb-select-search__input"
                           placeholder="@(SearchPlaceholder ?? L["Search_Placeholder"])"
                           value="@_searchText"
                           @oninput="OnSearchInput"
                           @ref="_searchRef" />
                </div>
            }
            <div class="sb-select-options">
                @if (_isLoading)
                {
                    <div class="sb-select-empty">
                        <span>@L["Loading"]</span>
                    </div>
                }
                else if (FilteredItems.Any())
                {
                    @foreach (var item in FilteredItems)
                    {
                        var itemValue = ValueField(item);
                        var isSelected = Values?.Contains(itemValue) ?? false;
                        var isDisabled = IsItemDisabled(item);
                        <button type="button"
                                class="@GetOptionClass(isSelected, isDisabled)"
                                role="option"
                                aria-selected="@isSelected"
                                aria-disabled="@isDisabled"
                                disabled="@isDisabled"
                                @onclick="() => ToggleItem(item)">
                            @if (isSelected)
                            {
                                <span>✓</span>
                            }
                            @if (ItemTemplate != null)
                            {
                                @ItemTemplate(item)
                            }
                            else
                            {
                                @TextField(item)
                            }
                        </button>
                    }
                }
                else
                {
                    <div class="sb-select-empty">
                        @if (NoResultsTemplate != null)
                        {
                            @NoResultsTemplate
                        }
                        else
                        {
                            <span>@(NoResultsText ?? L["NoResultsFound"])</span>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>


@code {
    private ElementReference _anchorRef;
    private ElementReference _searchRef;
    private DotNetObjectReference<SbMultiSelect<TItem, TValue>>? _dotNetRef;
    private bool _isOpen;
    private string _searchText = "";
    private bool _shouldFlip;
    private bool _isLoading;
    private List<TItem> _remoteItems = new();
    private System.Timers.Timer? _debounceTimer;

    /// <summary>
    /// Selected values.
    /// </summary>
    [Parameter]
    public IReadOnlyList<TValue>? Values { get; set; }

    /// <summary>
    /// Callback when values change.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<TValue>> ValuesChanged { get; set; }

    /// <summary>
    /// Items to select from.
    /// </summary>
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Function to get display text from item.
    /// </summary>
    [Parameter]
    public Func<TItem, string> TextField { get; set; } = item => item?.ToString() ?? "";

    /// <summary>
    /// Function to get value from item.
    /// </summary>
    [Parameter]
    public Func<TItem, TValue> ValueField { get; set; } = item => (TValue)(object)item!;

    /// <summary>
    /// Placeholder text. When null, uses localized default.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Placeholder text for the search input. When null, uses localized default.
    /// </summary>
    [Parameter]
    public string? SearchPlaceholder { get; set; }

    /// <summary>
    /// Text to display when no results are found. When null, uses localized default.
    /// </summary>
    [Parameter]
    public string? NoResultsText { get; set; }

    /// <summary>
    /// Aria label for remove chip button.
    /// </summary>
    [Parameter]
    public string? RemoveAriaLabel { get; set; }

    /// <summary>
    /// Whether the select is searchable.
    /// </summary>
    [Parameter]
    public bool Searchable { get; set; }

    /// <summary>
    /// Async function to fetch items based on search text. When set, search queries the backend instead of filtering local items only.
    /// </summary>
    [Parameter]
    public Func<string, Task<IEnumerable<TItem>>>? SearchFunc { get; set; }

    /// <summary>
    /// Minimum characters before remote search executes.
    /// </summary>
    [Parameter]
    public int MinLength { get; set; }

    /// <summary>
    /// Debounce delay in milliseconds for remote search.
    /// </summary>
    [Parameter]
    public int DebounceMs { get; set; } = 300;

    /// <summary>
    /// Maximum number of remote search results to show.
    /// </summary>
    [Parameter]
    public int MaxResults { get; set; } = 50;

    /// <summary>
    /// Maximum number of selections.
    /// </summary>
    [Parameter]
    public int? MaxSelected { get; set; }

    /// <summary>
    /// Whether the select is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Optional predicate that marks individual items as disabled (not selectable).
    /// </summary>
    [Parameter]
    public Func<TItem, bool>? ItemDisabledField { get; set; }

    /// <summary>
    /// Element ID.
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Label text displayed above the select.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Whether the field is required (shows asterisk).
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Custom item template.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>
    /// Custom chip template.
    /// </summary>
    [Parameter]
    public RenderFragment<TItem>? ChipTemplate { get; set; }

    /// <summary>
    /// Template for no results.
    /// </summary>
    [Parameter]
    public RenderFragment? NoResultsTemplate { get; set; }

    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Inline styles for the wrapper element.
    /// </summary>
    [Parameter]
    public string? Style { get; set; }

    private string TriggerCssClass
    {
        get
        {
            var classes = new List<string> { "sb-multi-select-trigger" };
            if (Disabled)
            {
                classes.Add("sb-multi-select--disabled");
            }
            return string.Join(" ", classes);
        }
    }

    private string DropdownClass => _shouldFlip ? "sb-select-dropdown sb-select-dropdown--flip-up" : "sb-select-dropdown";

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (SearchFunc != null)
            {
                return _remoteItems;
            }

            if (Items == null)
            {
                return Enumerable.Empty<TItem>();
            }
            
            if (string.IsNullOrWhiteSpace(_searchText))
            {
                return Items;
            }

            return Items.Where(item => 
                TextField(item).Contains(_searchText, StringComparison.OrdinalIgnoreCase));
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";

        if (SearchFunc == null)
        {
            StateHasChanged();
            return;
        }

        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();

        if (DebounceMs <= 0)
        {
            await PerformRemoteSearchAsync();
            return;
        }

        _debounceTimer = new System.Timers.Timer(DebounceMs);
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await PerformRemoteSearchAsync();
                StateHasChanged();
            });
        };
        _debounceTimer.Start();
    }

    private async Task PerformRemoteSearchAsync()
    {
        if (SearchFunc == null)
        {
            return;
        }

        if (_searchText.Length < MinLength)
        {
            _remoteItems.Clear();
            StateHasChanged();
            return;
        }

        _isLoading = true;
        StateHasChanged();

        try
        {
            var results = await SearchFunc(_searchText);
            _remoteItems = results.Take(MaxResults).ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private IEnumerable<TItem> GetItemSource()
    {
        if (SearchFunc != null)
        {
            return _remoteItems;
        }

        return Items ?? Enumerable.Empty<TItem>();
    }

    private TItem? GetItemByValue(TValue value)
    {
        foreach (var item in GetItemSource())
        {
            if (EqualityComparer<TValue>.Default.Equals(ValueField(item), value))
            {
                return item;
            }
        }

        if (Items == null)
        {
            return default;
        }

        foreach (var item in Items)
        {
            if (EqualityComparer<TValue>.Default.Equals(ValueField(item), value))
            {
                return item;
            }
        }

        return default;
    }

    private bool IsItemDisabled(TItem item) => ItemDisabledField?.Invoke(item) == true;

    private string GetOptionClass(bool isSelected, bool isDisabled)
    {
        var classes = new List<string> { "sb-select-option" };
        if (isSelected)
        {
            classes.Add("sb-select-option--selected");
        }
        if (isDisabled)
        {
            classes.Add("sb-select-option--disabled");
        }
        return string.Join(" ", classes);
    }

    private async Task Toggle()
    {
        if (Disabled) return;
        
        _isOpen = !_isOpen;
        _searchText = "";

        if (_isOpen)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.register", _anchorRef, _dotNetRef, "OnClickAway");
            
            // Check if dropdown should flip up
            _shouldFlip = await JSRuntime.InvokeAsync<bool>("SufiBlazor.select.shouldFlipUp", _anchorRef, 300);

            if (SearchFunc != null)
            {
                await PerformRemoteSearchAsync();
            }

            StateHasChanged();
        }
        else
        {
            _shouldFlip = false;
            await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.unregister", _anchorRef);
        }
    }

    private async Task ToggleItem(TItem item)
    {
        if (IsItemDisabled(item))
        {
            return;
        }

        var value = ValueField(item);
        var currentValues = Values?.ToList() ?? new List<TValue>();

        if (currentValues.Contains(value))
        {
            currentValues.Remove(value);
        }
        else
        {
            if (MaxSelected.HasValue && currentValues.Count >= MaxSelected.Value)
            {
                return; // Don't add more than max
            }
            currentValues.Add(value);
        }

        await ValuesChanged.InvokeAsync(currentValues);
    }

    private async Task RemoveValue(TValue value)
    {
        var currentValues = Values?.ToList() ?? new List<TValue>();
        currentValues.Remove(value);
        await ValuesChanged.InvokeAsync(currentValues);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && _isOpen)
        {
            _isOpen = false;
            await JSRuntime.InvokeVoidAsync("SufiBlazor.clickAway.unregister", _anchorRef);
        }
        else if (args.Key is "Enter" or " " or "ArrowDown" && !_isOpen)
        {
            await Toggle();
        }
    }

    [JSInvokable]
    public async Task OnClickAway()
    {
        if (_isOpen)
        {
            _isOpen = false;
            _searchText = "";
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _debounceTimer?.Dispose();
    }
}
