@page "/demo/sufi-blazor/breadcrumb"

<PageTitle>@(L["Menu:Demo:Breadcrumb"] + " - " + L["Menu:Demo:SufiBlazorDemo"])</PageTitle>

<DemoLayout>
    <SbHeading Level="1">@L["Menu:Demo:Breadcrumb"]</SbHeading>
    <SbText Color="SbColor.Muted">@L["Demo:BreadcrumbDescription"]</SbText>

    <SbDivider />

    <DemoSection Title="@L["Demo:BreadcrumbBasic"]" SourceCode="@basicCode" RelatedCode="@basicCodeBehind">
        <ExampleContent>
            <SbBreadcrumb Items="@_basicItems" />
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbWithHomeLink"]" SourceCode="@homeCode" RelatedCode="@homeCodeBehind">
        <ExampleContent>
            <SbBreadcrumb Items="@_homeItems" />
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbDeepNavigation"]" SourceCode="@deepCode" RelatedCode="@deepCodeBehind">
        <ExampleContent>
            <SbBreadcrumb Items="@_deepItems" />
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbCustomSeparator"]" SourceCode="@separatorCode" RelatedCode="@separatorCodeBehind">
        <ExampleContent>
            <SbStack Gap="4">
                <div>
                    <SbText Size="SbSize.Sm" Color="SbColor.Muted" style="margin-bottom: var(--sb-space-2);">@L["Demo:BreadcrumbSeparatorArrow"]</SbText>
                    <SbBreadcrumb Items="@_basicItems" Separator="→" />
                </div>
                
                <div>
                    <SbText Size="SbSize.Sm" Color="SbColor.Muted" style="margin-bottom: var(--sb-space-2);">@L["Demo:BreadcrumbSeparatorChevron"]</SbText>
                    <SbBreadcrumb Items="@_basicItems" Separator="›" />
                </div>
                
                <div>
                    <SbText Size="SbSize.Sm" Color="SbColor.Muted" style="margin-bottom: var(--sb-space-2);">@L["Demo:BreadcrumbSeparatorPipe"]</SbText>
                    <SbBreadcrumb Items="@_basicItems" Separator="|" />
                </div>
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbEcommerce"]" SourceCode="@ecommerceCode" RelatedCode="@ecommerceCodeBehind">
        <ExampleContent>
            <SbStack Gap="4">
                <SbCard>
                    <SbBreadcrumb Items="@_ecommerceItems" />
                    <SbDivider />
                    <SbHeading Level="3">Wireless Mouse</SbHeading>
                    <SbText>Ergonomic wireless mouse with precision tracking.</SbText>
                </SbCard>
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbDocumentation"]" SourceCode="@docsCode" RelatedCode="@docsCodeBehind">
        <ExampleContent>
            <SbCard>
                <SbBreadcrumb Items="@_docsItems" />
                <SbDivider />
                <SbHeading Level="2">Button Component</SbHeading>
                <SbText Color="SbColor.Muted">Interactive button component with multiple variants and sizes.</SbText>
            </SbCard>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbAdminPanel"]" SourceCode="@adminCode" RelatedCode="@adminCodeBehind">
        <ExampleContent>
            <SbCard>
                <SbBreadcrumb Items="@_adminItems" />
                <SbDivider />
                <SbHeading Level="2">Edit User Profile</SbHeading>
                <SbText Color="SbColor.Muted">Modify user information and settings.</SbText>
            </SbCard>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:BreadcrumbWithoutLinks"]" SourceCode="@noLinksCode" RelatedCode="@noLinksCodeBehind">
        <ExampleContent>
            <SbBreadcrumb Items="@_noLinksItems" />
        </ExampleContent>
    </DemoSection>

    <SbDivider />

    <DocViewer DocName="SbBreadcrumb" />
</DemoLayout>

