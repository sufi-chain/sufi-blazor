    </SbGridItem>
    <SbGridItem>
        <SbCard Elevation=""2""><SbText>Item 3</SbText></SbCard>
    </SbGridItem>
</SbGrid>";

    private const string responsiveCode = @"<SbGrid Columns=""1"" ColumnsSm=""2"" ColumnsMd=""3"" ColumnsLg=""4"" Gap=""4"">
    <SbGridItem>
