@page "/demo/sufi-blazor/markdown-editor"
@using SufiChain.SufiBlazor.Components.Forms
@using SufiChain.SufiBlazor.Contracts.Editors

<PageTitle>@(L["Menu:Demo:MarkdownEditor"] + " - " + L["Menu:Demo:SufiBlazorDemo"])</PageTitle>

<DemoLayout>
    <SbHeading Level="1">@L["Menu:Demo:MarkdownEditor"]</SbHeading>
    <SbText Color="SbColor.Muted">@L["Demo:MarkdownEditorPageDescription"]</SbText>

    <SbDivider />

    <DemoSection Title="@L["Demo:MarkdownEditorToolbar"]" SourceCode="@toolbarCode" RelatedCode="@toolbarCodeBehind">
        <ExampleContent>
            <SbStack Gap="3">
                <SbText Color="SbColor.Muted">@L["Demo:MarkdownEditorToolbarHint"]</SbText>
                <SbRichTextEditor @bind-Value="_toolbarContent"
                                  Mode="SbEditorMode.Wysiwyg"
                                  ContentFormat="SbContentFormat.Markdown"
                                  UseToolbarContributors="true"
                                  MinHeight="360px" />
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:MarkdownEditorMermaidHighlight"]" SourceCode="@previewCode" RelatedCode="@previewCodeBehind">
        <ExampleContent>
            <SbStack Gap="3">
                <SbText Color="SbColor.Muted">@L["Demo:MarkdownEditorMermaidHighlightHint"]</SbText>
                <SbRichTextEditor @bind-Value="_previewContent"
                                  Mode="SbEditorMode.Wysiwyg"
                                  ContentFormat="SbContentFormat.Markdown"
                                  UseToolbarContributors="true"
                                  MinHeight="420px" />
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:MarkdownEditorSourceMode"]" SourceCode="@sourceCode" RelatedCode="@sourceCodeBehind">
        <ExampleContent>
            <SbStack Gap="3">
                <SbText Color="SbColor.Muted">@L["Demo:MarkdownEditorSourceModeHint"]</SbText>
                <SbCodeEditor @bind-Value="_sourceContent"
                              Language="SbCodeLanguage.Html"
                              UseToolbarContributors="true"
                              HideToolbar="false"
                              MinHeight="240px" />
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:MarkdownEditorDiffReview"]" SourceCode="@diffCode" RelatedCode="@diffCodeBehind">
        <ExampleContent>
            <SbStack Gap="3">
                <SbText Color="SbColor.Muted">@L["Demo:MarkdownEditorDiffReviewHint"]</SbText>
                <SbDocumentDiffEditor OriginalValue="@_originalContent"
                                      SuggestedValue="@_suggestedContent"
                                      SuggestedValueChanged="@((string v) => _suggestedContent = v)"
                                      Language="SbCodeLanguage.Markdown"
                                      MinHeight="280px" />
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="@L["Demo:MarkdownEditorNoToolbar"]" SourceCode="@noToolbarCode" RelatedCode="@noToolbarCodeBehind">
        <ExampleContent>
            <SbRichTextEditor @bind-Value="_plainContent"
                              Mode="SbEditorMode.Wysiwyg"
                              ContentFormat="SbContentFormat.Markdown"
                              HideToolbar="true"
                              MinHeight="180px" />
        </ExampleContent>
    </DemoSection>

    <DemoSection Title="JSON editor" SourceCode="@jsonCode" RelatedCode="@jsonCodeBehind">
        <ExampleContent>
            <SbStack Gap="3">
                <SbText Color="SbColor.Muted">JSON source editor with validation.</SbText>
                @if (!_jsonValid)
                {
                    <SbAlert Color="SbColor.Danger">Invalid JSON syntax.</SbAlert>
                }
                <SbCodeEditor @bind-Value="_jsonContent"
                              Language="SbCodeLanguage.Json"
                              ValidateJson="true"
                              JsonValidChanged="@((valid) => _jsonValid = valid)"
                              MinHeight="240px" />
            </SbStack>
        </ExampleContent>
    </DemoSection>

    <SbDivider />

    <DocViewer DocName="SbRichTextEditor" />
</DemoLayout>

@code {
    private string _toolbarContent = """
        # Toolbar demo

        Use the toolbar for **bold**, _italic_, lists, links, and headings.
        """;

    private string _previewContent = """
        # Mermaid and highlight

        ## Syntax highlighting

        ```csharp
        public sealed class OrderService
        {
            public async Task ConfirmAsync(Guid orderId, CancellationToken ct = default)
            {
                await _repository.UpdateStatusAsync(orderId, OrderStatus.Confirmed, ct);
            }
        }
        ```

        ## Mermaid flowchart

        ```mermaid
        flowchart LR
            Draft --> Review
            Review -->|Approve| Publish
            Review -->|Reject| Draft
        ```
        """;

    private string _sourceContent =
        "<div class=\"email-template\">\n" +
        "  <h1>{{ subject }}</h1>\n" +
        "  <p>Hello {{ user.name }},</p>\n" +
        "</div>";

    private string _originalContent = "Hello {{ user.name }},\nYour order is confirmed.";
    private string _suggestedContent = "Hello {{ user.name }},\nYour order **#{{ order.id }}** is confirmed.";

    private string _plainContent = "Plain markdown with the toolbar hidden.";
    private bool _jsonValid = true;
    private string _jsonContent = """
        {
          "temperature": 0.7,
          "maxTokens": 2000,
          "useRag": true,
          "ragTopK": 5
        }
        """;

    private const string toolbarCodeBehind = @"private string _toolbarContent = ""# Toolbar demo"";";

    private const string toolbarCode = @"<SbRichTextEditor @bind-Value=""_toolbarContent""
                  Mode=""SbEditorMode.Wysiwyg""
                  ContentFormat=""SbContentFormat.Markdown""
                  UseToolbarContributors=""true""
                  MinHeight=""360px"" />";

    private const string previewCodeBehind = @"private string _previewContent = ""# Mermaid and highlight..."";";

    private const string previewCode = @"<SbRichTextEditor @bind-Value=""_previewContent""
                  Mode=""SbEditorMode.Wysiwyg""
                  ContentFormat=""SbContentFormat.Markdown""
                  UseToolbarContributors=""true"" />";

    private const string sourceCodeBehind = @"private string _sourceContent = ""<div>...</div>"";";

    private const string sourceCode = @"<SbCodeEditor @bind-Value=""_sourceContent""
              Language=""SbCodeLanguage.Html""
              UseToolbarContributors=""true""
              HideToolbar=""false"" />";

    private const string diffCodeBehind = @"private string _originalContent = ""..."";\nprivate string _suggestedContent = ""..."";";

    private const string diffCode = @"<SbDocumentDiffEditor OriginalValue=""@_originalContent""
                      SuggestedValue=""@_suggestedContent""
                      SuggestedValueChanged=""@((string v) => _suggestedContent = v)""
                      Language=""SbCodeLanguage.Markdown"" />";

    private const string noToolbarCodeBehind = @"private string _plainContent = ""Plain markdown"";";

    private const string noToolbarCode = @"<SbRichTextEditor @bind-Value=""_plainContent""
                  ContentFormat=""SbContentFormat.Markdown""
                  HideToolbar=""true"" />";

    private const string jsonCodeBehind = @"private string _jsonContent = ""{ \""temperature\"": 0.7 }"";";

    private const string jsonCode = @"<SbCodeEditor @bind-Value=""_jsonContent""
              Language=""SbCodeLanguage.Json""
              ValidateJson=""true""
              JsonValidChanged=""@((valid) => _jsonValid = valid)"" />";
}
