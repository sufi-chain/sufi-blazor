@page "/demo/sufi-blazor/settings-layout"

<PageTitle>@(L["Menu:Demo:SettingsLayout"] + " - " + L["Menu:Demo:SufiBlazorDemo"])</PageTitle>

<DemoLayout>
    <SbHeading Level="1">@L["Menu:Demo:SettingsLayout"]</SbHeading>
    <SbText Color="SbColor.Muted">@L["Demo:SettingsLayoutDescription"]</SbText>

    <SbDivider />

    <DemoSection Title="@L["Demo:SettingsLayoutBasic"]">
        <ExampleContent>
            <SbSettingsLayout AriaLabel="@L["Menu:Demo:SettingsLayout"]">
                <SbSettingsSection Id="email" Label="@L["Demo:SettingsEmail"]" Icon="mail" Title="@L["Demo:SettingsEmailTitle"]" Description="@L["Demo:SettingsEmailDescription"]" @bind-IsDirty="_emailDirty" OnSave="SaveEmailAsync" OnDiscard="DiscardEmailAsync">
                    <SbTextField TValue="string" @bind-Value="EmailDraft" Label="@L["Demo:SettingsEmail"]" />
                </SbSettingsSection>
                <SbSettingsSection Id="identity" Label="@L["Demo:SettingsIdentity"]" Icon="user-cog" Description="@L["Demo:SettingsIdentityDescription"]" @bind-IsDirty="_identityDirty" OnSave="SaveIdentityAsync" OnDiscard="DiscardIdentityAsync">
                    <SbTextField TValue="string" @bind-Value="IdentityDraft" Label="@L["Demo:SettingsIdentity"]" />
                </SbSettingsSection>
                <SbSettingsSection Id="timezone" Label="@L["Demo:SettingsTimeZone"]" Icon="clock" ReadOnly="true" OnSave="SaveIdentityAsync">
                    <SbText>@L["Demo:SettingsReadOnlyBody"]</SbText>
                </SbSettingsSection>
                <SbSettingsSection Id="short-links" Label="@L["Demo:SettingsShortLinks"]" Icon="link" Disabled="true" DisabledReason="@L["Demo:SettingsDisabledReason"]" />
                <SbSettingsSection Id="hidden" Label="Hidden" Icon="eye-off" Visible="false" />
            </SbSettingsLayout>
        </ExampleContent>
    </DemoSection>
</DemoLayout>
