    <SbCard>
        <SbHeading Level=""4"" Size=""6"">Item 3</SbHeading>
        <SbText Color=""SbColor.Muted"">Description for item 3.</SbText>
    </SbCard>
</SbGrid>";

    private string elevationCode = @"<SbStack Direction=""SbStackDirection.Row"" Gap=""4"" Wrap=""true"">
    <SbCard Elevation=""0"">
        <SbHeading Level=""4"" Size=""6"">Elevation 0</SbHeading>
        <SbText Color=""SbColor.Muted"">Flat, no shadow.</SbText>
    </SbCard>
    <SbCard Elevation=""1"">
        <SbHeading Level=""4"" Size=""6"">Elevation 1</SbHeading>
        <SbText Color=""SbColor.Muted"">Default level.</SbText>
    </SbCard>
    <SbCard Elevation=""2"">
        <SbHeading Level=""4"" Size=""6"">Elevation 2</SbHeading>
        <SbText Color=""SbColor.Muted"">Slightly raised.</SbText>
    </SbCard>
    <SbCard Elevation=""3"">
        <SbHeading Level=""4"" Size=""6"">Elevation 3</SbHeading>
        <SbText Color=""SbColor.Muted"">More prominent.</SbText>
    </SbCard>
    <SbCard Elevation=""5"">
        <SbHeading Level=""4"" Size=""6"">Elevation 5</SbHeading>
        <SbText Color=""SbColor.Muted"">Highest shadow.</SbText>
    </SbCard>
</SbStack>";
}
